<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CatHotel.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CatHotel"
    xmlns:views="clr-namespace:CatHotel.Views"
    Shell.NavBarIsVisible="False"
    Title="CatHotel">

    <TabBar Shell.TabBarIsVisible="False">
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate views:HomePage}"
            Route="HomePage" />

        <ShellContent
            Title="Calendar"
            ContentTemplate="{DataTemplate views:CalendarPage}"
            Route="CalendarPage" />

        <ShellContent
        Title="📊  Sales" 
        ContentTemplate="{DataTemplate views:Sales}" 
        Route="Sales" />
    </TabBar>
</Shell>
