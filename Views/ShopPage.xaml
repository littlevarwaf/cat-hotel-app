<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatHotel.Views.ShopPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#FFF5F5"
             Title="Shop">

    <AbsoluteLayout>

        <Grid AbsoluteLayout.LayoutBounds="0,0,1,1"
              AbsoluteLayout.LayoutFlags="All"
              RowDefinitions="Auto,*">

            <Border Grid.Row="0" BackgroundColor="White" Padding="16,12"
                    StrokeThickness="0" Margin="0">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.1"/>
                </Border.Shadow>
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <Label Text="Shop Items" FontSize="20" FontAttributes="Bold"
                           TextColor="#212121" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="🐾" FontSize="28"
                           VerticalOptions="Center" Margin="0,0,12,0"/>
                    <Grid Grid.Column="2">
                        <Button Text="🛒" BackgroundColor="Transparent" TextColor="#212121"
                                FontSize="22" Padding="4" Clicked="OnCartClicked"/>
                        <Border x:Name="CartBadge" BackgroundColor="#E91E63"
                                WidthRequest="20" HeightRequest="20" StrokeThickness="0"
                                HorizontalOptions="End" VerticalOptions="Start"
                                Margin="0,-2,-2,0" IsVisible="False">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Label x:Name="CartCountLabel" Text="0" TextColor="White"
                                   FontSize="10" FontAttributes="Bold"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <CollectionView Grid.Row="1" x:Name="ShopCollection"
                            SelectionMode="None" Margin="8">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2"
                                     VerticalItemSpacing="8" HorizontalItemSpacing="8"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="White" StrokeThickness="0" Margin="0,2">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08"/>
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnItemTapped"
                                                      CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="140,Auto">
                                <Border BackgroundColor="#FFCDD2" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12,12,0,0"/>
                                    </Border.StrokeShape>
                                    <Grid>
                                        <Label Text="🐟" FontSize="50"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Border Margin="6,6,0,0" Padding="6,3" StrokeThickness="0"
                                                BackgroundColor="#E91E63"
                                                HorizontalOptions="Start" VerticalOptions="Start">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding ItemPrice, StringFormat='฿{0:N0}'}" TextColor="White"
                                                   FontSize="11" FontAttributes="Bold"/>
                                        </Border>
                                        <Border Margin="0,6,6,0" Padding="5,2" StrokeThickness="0"
                                                BackgroundColor="#4CAF50"
                                                HorizontalOptions="End" VerticalOptions="Start"
                                                IsVisible="{Binding IsNew}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6"/>
                                            </Border.StrokeShape>
                                            <Label Text="NEW" TextColor="White"
                                                   FontSize="10" FontAttributes="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackLayout Grid.Row="1" Padding="10,8">
                                    <Label Text="{Binding Name}" FontSize="13"
                                           FontAttributes="Bold" TextColor="#212121"/>
                                    <Label Text="{Binding Description}"
                                           FontSize="11" TextColor="#757575"/>
                                </StackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <BoxView x:Name="DimOverlay"
                 AbsoluteLayout.LayoutBounds="0,0,1,1"
                 AbsoluteLayout.LayoutFlags="All"
                 Color="#80000000"
                 IsVisible="False"
                 InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDimTapped"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="PopupCard"
                AbsoluteLayout.LayoutBounds="0,1,1,AutoSize"
                AbsoluteLayout.LayoutFlags="XProportional,YProportional,WidthProportional"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="20,16,20,32"
                IsVisible="False">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24,24,0,0"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,-4" Radius="16" Opacity="0.25"/>
            </Border.Shadow>

            <StackLayout Spacing="14">

                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Text="✕" BackgroundColor="Transparent" TextColor="#9E9E9E"
                            FontSize="18" Padding="0" WidthRequest="36" HeightRequest="36"
                            Clicked="OnClosePopup"/>
                    <Label Grid.Column="1"/>
                    <Border x:Name="PopupNewBadge" Grid.Column="2"
                            BackgroundColor="#4CAF50" StrokeThickness="0"
                            Padding="10,4" IsVisible="False" VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Label Text="NEWLOOK!!" TextColor="White"
                               FontSize="11" FontAttributes="Bold"/>
                    </Border>
                </Grid>

                <Border BackgroundColor="#FFCDD2" StrokeThickness="0" HeightRequest="180">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Label x:Name="PopupEmoji" Text="🐟" FontSize="80"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackLayout VerticalOptions="Center">
                        <Label x:Name="PopupName" Text="" FontSize="20"
                               FontAttributes="Bold" TextColor="#212121"/>
                        <Label x:Name="PopupDesc" Text="" FontSize="13" TextColor="#9E9E9E"/>
                    </StackLayout>
                    <Grid Grid.Column="1" ColumnDefinitions="38,36,38"
                          VerticalOptions="Center" ColumnSpacing="2">
                        <Button Text="−" BackgroundColor="#FCE4EC" TextColor="#E91E63"
                                FontSize="20" CornerRadius="19"
                                WidthRequest="38" HeightRequest="38"
                                Padding="0" Clicked="OnDecrement"/>
                        <Label x:Name="PopupQty" Grid.Column="1" Text="1"
                               FontSize="17" FontAttributes="Bold" TextColor="#212121"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                        <Button Grid.Column="2" Text="+" BackgroundColor="#FCE4EC"
                                TextColor="#E91E63" FontSize="20" CornerRadius="19"
                                WidthRequest="38" HeightRequest="38"
                                Padding="0" Clicked="OnIncrement"/>
                    </Grid>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border BackgroundColor="#F5F5F5" StrokeThickness="0" Padding="12,14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Label x:Name="PopupPrice" Text="" FontSize="16"
                               FontAttributes="Bold" TextColor="#E91E63"
                               HorizontalOptions="Center"/>
                    </Border>
                    <Button Grid.Column="1" Text="🛒  Add to Cart"
                            BackgroundColor="#E91E63" TextColor="White"
                            CornerRadius="12" FontSize="14" HeightRequest="52"
                            Clicked="OnAddToCart"/>
                </Grid>

            </StackLayout>
        </Border>

    </AbsoluteLayout>
</ContentPage>
