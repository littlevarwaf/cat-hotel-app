<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatHotel.Views.ShopPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#FFF5F5">

    <ContentView.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F7D7D7" Offset="0.0" />
            <GradientStop Color="#FBEAEA" Offset="0.25" />
            <GradientStop Color="#FFF7EF" Offset="1.0" />
        </LinearGradientBrush>
    </ContentView.Background>

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Border Grid.Row="0" BackgroundColor="White" Padding="16,12"
                StrokeThickness="0" Margin="0">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.1"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto,Auto">
                <Label Text="Shop Items" FontSize="20" FontAttributes="Bold"
                       TextColor="#212121" VerticalOptions="Center"/>
                <Image Grid.Column="2" Source="app_icon.svg" HeightRequest="32" WidthRequest="32"/>
            </Grid>
        </Border>

        <!-- Items Grid Container -->
        <Grid Grid.Row="1" RowDefinitions="*,Auto">

            <!-- ITEMS COLLECTION VIEW -->
            <CollectionView Grid.Row="0" 
                            x:Name="ShopCollection"
                            Margin="16,12,16,0"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*" RowSpacing="0">
                            <!-- Main Card -->
                            <Border Grid.Row="0" Grid.RowSpan="2"
                                    BackgroundColor="{StaticResource NeutralWhite}" 
                                    Stroke="{StaticResource Primary100}" 
                                    StrokeThickness="1" 
                                    Padding="2,10,2,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6"/>
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#20000000" Offset="0,2" Radius="6" Opacity="0.12"/>
                                </Border.Shadow>
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="0">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer CommandParameter="{Binding .}"
                                                              Tapped="OnItemTapped"/>
                                    </Grid.GestureRecognizers>

                                    <!-- Image Container -->
                                    <Grid Grid.Row="0" Padding="0,0,0,0">
                                        <Grid.WidthRequest>
                                            <OnPlatform x:TypeArguments="x:Double">
                                                <On Platform="iOS,Android,WinUI">140</On>
                                            </OnPlatform>
                                        </Grid.WidthRequest>
                                        <Border BackgroundColor="#FDECEC" 
                                                StrokeThickness="0"
                                                Padding="0"
                                                HorizontalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="0,0,0,0"/>
                                            </Border.StrokeShape>
                                            <Grid HeightRequest="156" WidthRequest="156">
                                                <Image Source="{Binding ImgUrl}" Aspect="AspectFill"/>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Item Info -->
                                    <VerticalStackLayout Grid.Row="1" Padding="12,8,12,12" Spacing="2">
                                        <Label Text="{Binding Name}"
                                               FontSize="13" 
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Neutral950}" 
                                               LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding Description}"
                                               FontSize="11" 
                                               TextColor="{StaticResource Neutral600}"
                                               LineBreakMode="TailTruncation"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>

                            <!-- Price Tag Badge (Overlay) -->
                            <Border Grid.Row="0"
                                    BackgroundColor="{StaticResource Neutral950}" 
                                    StrokeThickness="0"
                                    Padding="8,4"
                                    HorizontalOptions="End"
                                    VerticalOptions="Start"
                                    Margin="0,16,0,0"
                                    ZIndex="10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="999,0,999,0"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4">
                                    <Image Grid.Column="0"
                                           Source="price_tag_icon_white.svg"
                                           HeightRequest="12"
                                           WidthRequest="12"
                                           VerticalOptions="Center"/>
                                    <Label Grid.Column="1"
                                           Text="{Binding ItemPrice, StringFormat='฿{0:N0}'}"
                                           TextColor="{StaticResource NeutralWhite}" 
                                           FontSize="11" 
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- Footer spacing -->
                <CollectionView.Footer>
                    <BoxView HeightRequest="80" BackgroundColor="Transparent" />
                </CollectionView.Footer>
            </CollectionView>

            <!-- Floating Search Bar -->
            <Border Grid.Row="1" 
                    ZIndex="1"
                    Style="{StaticResource RoundedInputContainerStyle}"
                    Margin="16,0,16,128" 
                    Padding="12,0,12,0"
                    VerticalOptions="End"
                    HeightRequest="56"
                    WidthRequest="346">
                <Grid ColumnDefinitions="Auto,*">
                    <Image Grid.Column="0" Source="search_icon.svg" HeightRequest="16" WidthRequest="16" VerticalOptions="Center"/>
                    <Border Grid.Column="1" BackgroundColor="Transparent" Stroke="Transparent">
                        <Entry x:Name="SearchEntry" Style="{StaticResource RoundedEntryStyle}"
                               Placeholder="Search items..." />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Dim Overlay -->
        <BoxView x:Name="DimOverlay"
                 AbsoluteLayout.LayoutBounds="0,0,1,1"
                 AbsoluteLayout.LayoutFlags="All"
                 Color="Black"
                 Opacity="0.5"
                 IsVisible="False"
                 InputTransparent="False"
                 ZIndex="1000">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDimTapped"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Popup Card -->
        <Border x:Name="PopupCard"
                AbsoluteLayout.LayoutBounds="0,1,1,0.7"
                AbsoluteLayout.LayoutFlags="XProportional,YProportional,WidthProportional,HeightProportional"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="0"
                IsVisible="False"
                ZIndex="1001">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24,24,0,0"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,-4" Radius="16" Opacity="0.25"/>
            </Border.Shadow>

            <Grid RowDefinitions="*,Auto,Auto" Padding="0">

                <!-- Image Container with Close Button - Scrollable -->
                <ScrollView Grid.Row="0">
                    <Grid>
                        <!-- Image with 1:1 Aspect Ratio -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border BackgroundColor="#FFCDD2" StrokeThickness="0">
                            <Grid>
                                <Image x:Name="PopupImage" 
                                       Source="app_icon.svg"
                                       Aspect="AspectFill"/>

                                <!-- Fade Overlay -->
                                <BoxView BackgroundColor="White" Opacity="0.15"/>

                                <!-- Close Button (Top-Left) -->
                                <Button Text="✕" 
                                        BackgroundColor="White" 
                                        TextColor="#9E9E9E"
                                        FontSize="24" 
                                        Padding="0" 
                                        WidthRequest="44" 
                                        HeightRequest="44"
                                        CornerRadius="22"
                                        HorizontalOptions="Start" 
                                        VerticalOptions="Start"
                                        Margin="12,12,0,0"
                                        Clicked="OnClosePopup"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollView>

                <!-- Item Info Section -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Padding="20,16,20,12" ColumnSpacing="12">
                    <!-- Left: Name and Description -->
                    <StackLayout VerticalOptions="Center">
                        <Label x:Name="PopupName" 
                               Text="" 
                               FontSize="22"
                               FontAttributes="Bold" 
                               TextColor="#212121"/>
                        <Label x:Name="PopupDesc" 
                               Text="" 
                               FontSize="13" 
                               TextColor="#9E9E9E"
                               LineBreakMode="WordWrap"/>
                    </StackLayout>

                    <!-- Right: Quantity Control (Pills Style) -->
                    <Grid Grid.Column="1" 
                          ColumnDefinitions="38,40,38" 
                          VerticalOptions="Center" 
                          ColumnSpacing="0"
                          HeightRequest="48">
                        <Border BackgroundColor="#FCE4EC" 
                                StrokeThickness="0"
                                Padding="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24,0,0,24"/>
                            </Border.StrokeShape>
                            <Button Text="−" 
                                    BackgroundColor="Transparent"
                                    TextColor="#E91E63"
                                    FontSize="22" 
                                    Padding="0"
                                    Clicked="OnDecrement"
                                    VerticalOptions="Center"/>
                        </Border>

                        <Border Grid.Column="1" 
                                BackgroundColor="#FCE4EC" 
                                StrokeThickness="0"
                                Padding="0">
                            <Label x:Name="PopupQty" 
                                   Text="1"
                                   FontSize="16" 
                                   FontAttributes="Bold" 
                                   TextColor="#212121"
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                        </Border>

                        <Border Grid.Column="2" 
                                BackgroundColor="#FCE4EC" 
                                StrokeThickness="0"
                                Padding="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="0,24,24,0"/>
                            </Border.StrokeShape>
                            <Button Text="+" 
                                    BackgroundColor="Transparent"
                                    TextColor="#E91E63" 
                                    FontSize="22" 
                                    Padding="0"
                                    Clicked="OnIncrement"
                                    VerticalOptions="Center"/>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Price and Add to Cart  -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="20,8,20,20" RowSpacing="0">
                    <Border BackgroundColor="White" 
                            StrokeThickness="1"
                            Padding="16,12" 
                            VerticalOptions="End">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24"/>
                        </Border.StrokeShape>
                        <Label x:Name="PopupPrice" 
                               Text="" 
                               FontSize="16"
                               FontAttributes="Bold" 
                               TextColor="#E91E63"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                    <Button Grid.Column="1" 
                            Text="🛒  Add to Cart"
                            BackgroundColor="#E91E63" 
                            TextColor="White"
                            CornerRadius="12" 
                            FontSize="14" 
                            HeightRequest="52"
                            VerticalOptions="End"
                            Clicked="OnAddToCart"/>
                </Grid>

            </Grid>
        </Border>

    </Grid>
</ContentView>