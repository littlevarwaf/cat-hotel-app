<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatHotel.Views.ShopPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#FFF5F5">

    <AbsoluteLayout>

        <Grid AbsoluteLayout.LayoutBounds="0,0,1,1"
              AbsoluteLayout.LayoutFlags="All"
              RowDefinitions="Auto,*">

            <Border Grid.Row="0" BackgroundColor="White" Padding="16,12"
                    StrokeThickness="0" Margin="0">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.1"/>
                </Border.Shadow>
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <Label Text="Shop Items" FontSize="20" FontAttributes="Bold"
                           TextColor="#212121" VerticalOptions="Center"/>
                    <Image Grid.Column="2" Source="app_icon.svg" HeightRequest="32" WidthRequest="32"/>
                </Grid>
            </Border>

            <CollectionView Grid.Row="1" x:Name="ShopCollection"
                            SelectionMode="None" Margin="8">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2"
                                     VerticalItemSpacing="8" HorizontalItemSpacing="8"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="White" StrokeThickness="0" Margin="0,2">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08"/>
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnItemTapped"
                                                      CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="140,Auto">
                                <Border BackgroundColor="#FFCDD2" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12,12,0,0"/>
                                    </Border.StrokeShape>
                                    <Grid>
                                        <Label Text="🐟" FontSize="50"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Border Margin="6,6,0,0" Padding="6,3" StrokeThickness="0"
                                                BackgroundColor="#E91E63"
                                                HorizontalOptions="Start" VerticalOptions="Start">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding ItemPrice, StringFormat='฿{0:N0}'}" TextColor="White"
                                                   FontSize="11" FontAttributes="Bold"/>
                                        </Border>
                                        <Border Margin="0,6,6,0" Padding="5,2" StrokeThickness="0"
                                                BackgroundColor="#4CAF50"
                                                HorizontalOptions="End" VerticalOptions="Start"
                                                IsVisible="{Binding IsNew}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6"/>
                                            </Border.StrokeShape>
                                            <Label Text="NEW" TextColor="White"
                                                   FontSize="10" FontAttributes="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackLayout Grid.Row="1" Padding="10,8">
                                    <Label Text="{Binding Name}" FontSize="13"
                                           FontAttributes="Bold" TextColor="#212121"/>
                                    <Label Text="{Binding Description}"
                                           FontSize="11" TextColor="#757575"/>
                                </StackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Dim Overlay -->
        <BoxView x:Name="DimOverlay"
                 AbsoluteLayout.LayoutBounds="0,0,1,1"
                 AbsoluteLayout.LayoutFlags="All"
                 Color="Black"
                 Opacity="0.5"
                 IsVisible="False"
                 InputTransparent="False"
                 ZIndex="1000">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDimTapped"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Popup Card -->
        <Border x:Name="PopupCard"
                AbsoluteLayout.LayoutBounds="0,1,1,0.7"
                AbsoluteLayout.LayoutFlags="XProportional,YProportional,WidthProportional,HeightProportional"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="0"
                IsVisible="False"
                ZIndex="1001">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24,24,0,0"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,-4" Radius="16" Opacity="0.25"/>
            </Border.Shadow>

            <Grid RowDefinitions="*,Auto,Auto" Padding="0">

                <!-- Image Container with Close Button - Scrollable -->
                <ScrollView Grid.Row="0">
                    <Grid>
                        <!-- Image with 1:1 Aspect Ratio -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border BackgroundColor="#FFCDD2" StrokeThickness="0">
                            <Grid>
                                <Image x:Name="PopupImage" 
                                       Source="app_icon.svg"
                                       Aspect="AspectFill"/>

                                <!-- Fade Overlay -->
                                <BoxView BackgroundColor="White" Opacity="0.15"/>

                                <!-- Close Button (Top-Left) -->
                                <Button Text="✕" 
                                        BackgroundColor="White" 
                                        TextColor="#9E9E9E"
                                        FontSize="24" 
                                        Padding="0" 
                                        WidthRequest="44" 
                                        HeightRequest="44"
                                        CornerRadius="22"
                                        HorizontalOptions="Start" 
                                        VerticalOptions="Start"
                                        Margin="12,12,0,0"
                                        Clicked="OnClosePopup"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollView>

                <!-- Item Info Section -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Padding="20,16,20,12" ColumnSpacing="12">
                    <!-- Left: Name and Description -->
                    <StackLayout VerticalOptions="Center">
                        <Label x:Name="PopupName" 
                               Text="" 
                               FontSize="22"
                               FontAttributes="Bold" 
                               TextColor="#212121"/>
                        <Label x:Name="PopupDesc" 
                               Text="" 
                               FontSize="13" 
                               TextColor="#9E9E9E"
                               LineBreakMode="WordWrap"/>
                    </StackLayout>

                    <!-- Right: Quantity Control (Pills Style) -->
                    <Grid Grid.Column="1" 
                          ColumnDefinitions="38,40,38" 
                          VerticalOptions="Center" 
                          ColumnSpacing="0"
                          HeightRequest="48">
                        <Border BackgroundColor="#FCE4EC" 
                                StrokeThickness="0"
                                Padding="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24,0,0,24"/>
                            </Border.StrokeShape>
                            <Button Text="−" 
                                    BackgroundColor="Transparent"
                                    TextColor="#E91E63"
                                    FontSize="22" 
                                    Padding="0"
                                    Clicked="OnDecrement"
                                    VerticalOptions="Center"/>
                        </Border>

                        <Border Grid.Column="1" 
                                BackgroundColor="#FCE4EC" 
                                StrokeThickness="0"
                                Padding="0">
                            <Label x:Name="PopupQty" 
                                   Text="1"
                                   FontSize="16" 
                                   FontAttributes="Bold" 
                                   TextColor="#212121"
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                        </Border>

                        <Border Grid.Column="2" 
                                BackgroundColor="#FCE4EC" 
                                StrokeThickness="0"
                                Padding="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="0,24,24,0"/>
                            </Border.StrokeShape>
                            <Button Text="+" 
                                    BackgroundColor="Transparent"
                                    TextColor="#E91E63" 
                                    FontSize="22" 
                                    Padding="0"
                                    Clicked="OnIncrement"
                                    VerticalOptions="Center"/>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Price and Add to Cart  -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="20,8,20,20" RowSpacing="0">
                    <Border BackgroundColor="White" 
                            StrokeThickness="1"
                            Padding="16,12" 
                            VerticalOptions="End">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24"/>
                        </Border.StrokeShape>
                        <Label x:Name="PopupPrice" 
                               Text="" 
                               FontSize="16"
                               FontAttributes="Bold" 
                               TextColor="#E91E63"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                    <Button Grid.Column="1" 
                            Text="🛒  Add to Cart"
                            BackgroundColor="#E91E63" 
                            TextColor="White"
                            CornerRadius="12" 
                            FontSize="14" 
                            HeightRequest="52"
                            VerticalOptions="End"
                            Clicked="OnAddToCart"/>
                </Grid>

            </Grid>
        </Border>

    </AbsoluteLayout>
</ContentView>