<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             xmlns:tabs="http://sharpnado.com"
             xmlns:views="clr-namespace:CatHotel.Views"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             x:Class="CatHotel.Views.RoomWrapperPage">

    <Grid RowDefinitions="*">

        <tabs:ViewSwitcher Grid.Row="0" Padding="0,0,0,0"
                           SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <views:RoomDetailPage x:Name="RoomDetailPageInstance" />
            <views:ShopPage />
        </tabs:ViewSwitcher>

        <!-- Gradient overlay behind tabbar -->
        <BoxView Grid.Row="0" ZIndex="0" VerticalOptions="End" HeightRequest="128">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{StaticResource Primary100}" Offset="1" />
                    <GradientStop Color="#00F9D0D0" Offset="0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Floating tabbar container -->
        <Border Grid.Row="0" ZIndex="1" Margin="30,0,30,40" HeightRequest="70"
                BackgroundColor="Transparent" StrokeThickness="0"
                VerticalOptions="End">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="35" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="4,4" Radius="10" Opacity="0.15" />
            </Border.Shadow>

            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16" Padding="8">

                <!-- GROUP 1: Tab Navigation with white background -->
                <Border Grid.Column="0" HeightRequest="70" BackgroundColor="White" StrokeThickness="0" Padding="8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="35" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="4,4" Radius="10" Opacity="0.1" />
                    </Border.Shadow>

                    <tabs:TabHostView
                        SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                        BackgroundColor="Transparent"
                        TabType="Fixed">

                        <tabs:BottomTabItem Label="Room Details" IconImageSource="building_icon.svg" UnselectedIconColor="{StaticResource NeutralBase}" SelectedTabColor="{StaticResource Primary500}" />
                        <tabs:BottomTabItem Label="Shop" IconImageSource="shopping_bag_icon.svg" UnselectedIconColor="{StaticResource NeutralBase}" SelectedTabColor="{StaticResource Primary500}" />

                    </tabs:TabHostView>
                </Border>

                <!-- GROUP 2: Circular Button with pink background and badge -->
                <Grid Grid.Column="1" WidthRequest="70" HeightRequest="70">
                    <Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <Ellipse />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="4,4" Radius="10" Opacity="0.1" />
                        </Border.Shadow>

                        <Button
                            WidthRequest="70"
                            HeightRequest="70"
                            CornerRadius="35"
                            BackgroundColor="{StaticResource NeutralWhite}"
                            ImageSource="shopping_cart_icon.svg"
                            Command="{Binding GoToCartCommand}">
                        </Button>
                    </Border>

                    <!-- Badge -->
                    <Border
                        WidthRequest="28"
                        HeightRequest="28"
                        BackgroundColor="{StaticResource Primary}"
                        StrokeThickness="0"
                        Padding="0"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="0,-8,-8,0"
                        IsVisible="{Binding ShowCartBadge}">
                        <Border.StrokeShape>
                            <Ellipse />
                        </Border.StrokeShape>

                        <Label
                            Text="{Binding CartItemCount}"
                            TextColor="{StaticResource Primary900}"
                            FontSize="12"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />
                    </Border>
                </Grid>

            </Grid>
        </Border>

        <!-- Dim Overlay for Popup - Full screen, captures taps -->
        <BoxView x:Name="DimOverlay"
                 Grid.Row="0"
                 Color="Black"
                 Opacity="0.5"
                 IsVisible="False"
                 InputTransparent="False"
                 ZIndex="500">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDimTapped"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Popup Card - Stuck to Bottom with High ZIndex -->
        <Border x:Name="PopupCard"
                Grid.Row="0"
                Margin="0"
                BackgroundColor="{StaticResource Primary50}"
                StrokeThickness="0"
                Padding="0"
                IsVisible="False"
                VerticalOptions="End"
                InputTransparent="False"
                ZIndex="600">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24,24,0,0"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,-4" Radius="16" Opacity="0.25"/>
            </Border.Shadow>

            <Grid RowDefinitions="*,Auto,Auto" Padding="0" HeightRequest="640" InputTransparent="False">

                <!-- Image Container with Close Button -->
                <ScrollView Grid.Row="0">
                    <Frame>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer />
                        </Frame.GestureRecognizers>
                    </Frame>
                    <Grid>
                        <Border BackgroundColor="{StaticResource Primary50}" StrokeThickness="0">
                            <Grid>
                                <Image x:Name="PopupImage" 
                                       Source="app_icon.svg"
                                       Aspect="AspectFill"/>

                                <Button ImageSource="close_md_icon.svg"
                                        BackgroundColor="White" 
                                        TextColor="#9E9E9E"
                                        FontSize="24" 
                                        Padding="0" 
                                        WidthRequest="44" 
                                        HeightRequest="44"
                                        CornerRadius="22"
                                        HorizontalOptions="Start" 
                                        VerticalOptions="Start"
                                        Margin="12,12,0,0"
                                        Clicked="OnClosePopup"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollView>

                <!-- Fade Transition Between Image and Info -->
                <BoxView Grid.Row="0" 
                         VerticalOptions="End"
                         HeightRequest="64">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Color="{StaticResource Primary50}" Offset="0.0" />
                            <GradientStop Color="#00FDECEC" Offset="1.0" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>

                <!-- Item Info Section -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Padding="20,24,20,24" ColumnSpacing="12" InputTransparent="False">
                    <StackLayout VerticalOptions="Center">
                        <Label x:Name="PopupName" 
                               Text="" 
                               FontSize="22"
                               FontAttributes="Bold" 
                               TextColor="{StaticResource Neutral950}"/>
                        <Label x:Name="PopupDesc" 
                               Text="" 
                               FontSize="13" 
                               TextColor="{StaticResource Neutral600}"
                               LineBreakMode="WordWrap"/>
                    </StackLayout>

                    <Border
                        Grid.Column="1"
                        BackgroundColor="{StaticResource Neutral950}"
                        StrokeThickness="0"
                        Padding="8"
                        MaximumWidthRequest="128">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24"/>
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="32,*,32" 
                              VerticalOptions="Center" 
                              ColumnSpacing="16"
                              HeightRequest="32">
                            <!-- Left Button (Circular) -->
                            <Border BackgroundColor="{StaticResource NeutralWhite}" 
                                    StrokeThickness="0" 
                                    Padding="0">
                                <Border.StrokeShape>
                                    <Ellipse />
                                </Border.StrokeShape>
                                <Button ImageSource="minus_icon.svg" 
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource Neutral950}"
                                        FontSize="24"
                                        Padding="0"
                                        Clicked="OnDecrement"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>
                            </Border>

                            <!-- Quantity Number -->
                            <Label x:Name="PopupQty" 
                                   Grid.Column="1"
                                   Text="99"
                                   FontSize="24" 
                                   FontAttributes="Bold" 
                                   TextColor="{StaticResource NeutralWhite}"
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center"/>

                            <!-- Right Button (Circular) -->
                            <Border Grid.Column="2" 
                                    BackgroundColor="{StaticResource NeutralWhite}" 
                                    StrokeThickness="0" 
                                    Padding="0">
                                <Border.StrokeShape>
                                    <Ellipse />
                                </Border.StrokeShape>
                                <Button ImageSource="plus_icon.svg"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource Neutral950}"
                                        FontSize="24"
                                        Padding="0"
                                        Clicked="OnIncrement"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Price and Add to Cart -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="20,20,20,20" RowSpacing="0">
                    <Border BackgroundColor="{StaticResource NeutralWhite}" 
                            Stroke="{StaticResource Primary100}"
                            StrokeThickness="0.5"
                            Padding="32,0" 
                            VerticalOptions="Fill"
                            MinimumWidthRequest="128"
                            MaximumWidthRequest="128">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="999" />
                        </Border.StrokeShape>
                        <Label x:Name="PopupPrice" 
                               Text="NaN" 
                               FontSize="16"
                               FontAttributes="Bold" 
                               TextColor="{StaticResource Neutral950}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                    <Button Grid.Column="1"
                            ImageSource="add_plus_square_icon_white.svg"
                            Text="Add to Cart"
                            BackgroundColor="{StaticResource Primary500}" 
                            TextColor="{StaticResource NeutralWhite}"
                            CornerRadius="999" 
                            FontSize="18" 
                            FontAttributes="Bold"
                            HeightRequest="64"
                            VerticalOptions="End"
                            Clicked="OnAddToCart"/>
                </Grid>

            </Grid>
        </Border>

    </Grid>
</ContentPage>