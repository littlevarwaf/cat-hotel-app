<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatHotel.Views.CustomerViews.CustomerEditPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">
    <ContentPage.Background>
        <StaticResource Key="PageBackgroundBrush" />
    </ContentPage.Background>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="16,0,32,0" MinimumHeightRequest="56" StrokeThickness="0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" ImageSource="chevron_left.svg" BackgroundColor="Transparent"
                        Clicked="OnBackClicked"/>
                <Label Grid.Column="1" Text="แก้ไขลูกค้า" FontSize="18" FontAttributes="Bold"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
                <Image Grid.Column="2" Source="app_icon.svg" HeightRequest="28" WidthRequest="28"/>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="16">
                <Border BackgroundColor="{StaticResource NeutralWhite}" Stroke="{StaticResource Primary100}" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="ชื่อ" FontAttributes="Bold"/>
                            <Border Style="{StaticResource RoundedInputContainerStyle}">
                                <Entry x:Name="NameEntry" Style="{StaticResource RoundedEntryStyle}"/>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="เบอร์โทร" FontAttributes="Bold"/>
                            <Border Style="{StaticResource RoundedInputContainerStyle}">
                                <Entry x:Name="PhoneEntry" Keyboard="Telephone" Style="{StaticResource RoundedEntryStyle}"/>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="อีเมล" FontAttributes="Bold"/>
                            <Border Style="{StaticResource RoundedInputContainerStyle}">
                                <Entry x:Name="EmailEntry" Keyboard="Email" Style="{StaticResource RoundedEntryStyle}"/>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Button Text="บันทึก" BackgroundColor="#E91E63" TextColor="White"
                        CornerRadius="12" HeightRequest="52" Clicked="OnSaveClicked"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
