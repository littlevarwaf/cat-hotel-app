<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatHotel.Views.CustomerViews.CustomerAddView"
             BackgroundColor="{StaticResource Primary50}">

    <ContentView.Background>
        <StaticResource Key="PageBackgroundBrush" />
    </ContentView.Background>

    <Grid RowDefinitions="*,Auto">

        <!-- FORM SCROLL -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,16,16,120" Spacing="0">

                <Label Text="Customer Details"
                       FontSize="16" FontAttributes="Bold"
                       TextColor="#1A1A1A" Margin="0,0,0,12"/>

                <!-- Image Card -->
                <Border BackgroundColor="{StaticResource NeutralWhite}" Stroke="{StaticResource Primary100}" StrokeThickness="1"
                        Padding="16" Margin="0,0,0,16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#20000000" Offset="0,3" Radius="8" Opacity="0.15"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Border HeightRequest="180" WidthRequest="240"
                                StrokeThickness="0" HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6"/>
                            </Border.StrokeShape>
                            <Image x:Name="CustomerPhotoPreview"
                                   Source="placeholder_user.png"
                                   Aspect="AspectFill"
                                   HeightRequest="180" WidthRequest="180"/>
                        </Border>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Border Grid.Column="0" StrokeThickness="1" Stroke="{StaticResource Primary100}"
                                    BackgroundColor="{StaticResource NeutralWhite}" Padding="0,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="999"/>
                                </Border.StrokeShape>
                                <Label Text="Remove Image" FontSize="13"
                                       TextColor="{StaticResource Primary900}" HorizontalOptions="Center"/>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRemoveImageTapped"/>
                                </Border.GestureRecognizers>
                            </Border>
                            <Border Grid.Column="1" StrokeThickness="0"
                                    BackgroundColor="{StaticResource Primary}" Padding="0,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="999"/>
                                </Border.StrokeShape>
                                <Label Text="Upload Image" FontSize="13"
                                       TextColor="{StaticResource Primary900}" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnUploadImageTapped"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Input Fields Card -->
                <Border BackgroundColor="{StaticResource NeutralWhite}" Stroke="{StaticResource Primary100}" StrokeThickness="1"
                        Padding="16" Margin="0,0,0,24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#20000000" Offset="0,3" Radius="8" Opacity="0.15"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="24">

                        <!-- Customer Name -->
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                <Image Grid.Column="0" Source="user_icon.svg" HeightRequest="16" WidthRequest="16"/>
                                <Label Grid.Column="1" Text="Customer Name"
                                       FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Neutral950}"/>
                            </Grid>
                            <Border Style="{StaticResource RoundedInputContainerStyle}">
                                <Entry x:Name="NameEntry" 
                                       Placeholder="e.g., John Doe"
                                       Style="{StaticResource RoundedEntryStyle}"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Telephone Number -->
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                <Image Grid.Column="0" Source="phone_icon.svg" HeightRequest="16" WidthRequest="16"/>
                                <Label Grid.Column="1" Text="Telephone Number"
                                       FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Neutral950}"/>
                            </Grid>
                            <Border Style="{StaticResource RoundedInputContainerStyle}">
                                <Entry x:Name="TelephoneEntry"
                                       Placeholder="e.g., 0812345678"
                                       Keyboard="Telephone"
                                       Style="{StaticResource RoundedEntryStyle}"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Email -->
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                <Image Grid.Column="0" Source="mail_icon.svg" HeightRequest="16" WidthRequest="16"/>
                                <Label Grid.Column="1" Text="Email Address"
                                       FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Neutral950}"/>
                            </Grid>
                            <Border Style="{StaticResource RoundedInputContainerStyle}">
                                <Entry x:Name="EmailEntry"
                                       Placeholder="e.g., john@example.com"
                                       Keyboard="Email"
                                       Style="{StaticResource RoundedEntryStyle}"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Email -->
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                <Image Grid.Column="0" Source="chat_icon.svg" HeightRequest="16" WidthRequest="16"/>
                                <Label Grid.Column="1" Text="Line ID"
                                       FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Neutral950}"/>
                            </Grid>
                            <Border Style="{StaticResource RoundedInputContainerStyle}">
                                <Entry x:Name="LineIdEntry"
                                       Placeholder="e.g., johnexample"
                                       Style="{StaticResource RoundedEntryStyle}"/>
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Gradient overlay behind add button -->
        <BoxView Grid.Row="0" ZIndex="0" VerticalOptions="End" HeightRequest="128">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFF7EF" Offset="1" />
                    <GradientStop Color="#00FFF7EF" Offset="0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Floating Add Button -->
        <Border Grid.Row="0" ZIndex="1" Margin="30,0,30,40" HeightRequest="64"
                BackgroundColor="Transparent" StrokeThickness="0"
                VerticalOptions="End">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#E06060" Offset="0,4" Radius="12" Opacity="0.4" />
            </Border.Shadow>
            <Border BackgroundColor="{StaticResource Primary500}" StrokeThickness="0" Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="38"/>
                </Border.StrokeShape>
                <Label Text="+ Add Customer" TextColor="White" FontSize="16"
                       FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAddCustomerClicked"/>
                </Border.GestureRecognizers>
            </Border>
        </Border>

    </Grid>
</ContentView>