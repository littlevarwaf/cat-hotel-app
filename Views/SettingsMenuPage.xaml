<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatHotel.Views.SettingsMenuPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             Title="SettingsMenuPage">
    <ContentPage.Background>
        <StaticResource Key="PageBackgroundBrush" />
    </ContentPage.Background>

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" BackgroundColor="Transparent" Padding="16,0,32,0" MinimumHeightRequest="56"
                StrokeThickness="0" Margin="0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="0">
                <!-- Back Button -->
                <Button Grid.Column="0"
                        ImageSource="chevron_left.svg"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Neutral950}"
                        FontSize="28"
                        Padding="8,0"
                        Clicked="OnBackClicked"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"/>

                <!-- Title -->
                <Label Grid.Column="1"
                       Text="Settings Menu"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Neutral950}"
                       HorizontalOptions="Center"
                       VerticalTextAlignment="Center"
                       HorizontalTextAlignment="Center"/>

                <!-- Paw Icon -->
                <Image Grid.Column="2"
                       Source="app_icon.svg"
                       HeightRequest="28"
                       WidthRequest="28"
                       HorizontalOptions="End"
                       VerticalOptions="Center"/>
            </Grid>
        </Border>

        <!-- Menu Items Grid -->
        <ScrollView Grid.Row="1" Padding="16,16,16,16">
            <VerticalStackLayout Spacing="16">

                <!-- Room Settings -->
                <Border BackgroundColor="{StaticResource NeutralWhite}" 
                        Stroke="{StaticResource Primary100}" 
                        StrokeThickness="1"
                        Padding="20,24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#20000000" Offset="0,3" Radius="8" Opacity="0.15"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Image Source="building_icon.svg" 
                               HeightRequest="40" 
                               WidthRequest="40" 
                               HorizontalOptions="Center"/>
                        <Label Text="Room Settings"
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource Neutral950}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRoomSettingsClicked"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- Shop Settings -->
                <Border BackgroundColor="{StaticResource NeutralWhite}" 
                        Stroke="{StaticResource Primary100}" 
                        StrokeThickness="1"
                        Padding="20,24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#20000000" Offset="0,3" Radius="8" Opacity="0.15"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Image Source="shopping_bag_icon.svg" 
                               HeightRequest="40" 
                               WidthRequest="40" 
                               HorizontalOptions="Center"/>
                        <Label Text="Shop Settings"
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource Neutral950}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnShopSettingsClicked"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- Discount Settings -->
                <Border BackgroundColor="{StaticResource NeutralWhite}" 
                        Stroke="{StaticResource Primary100}" 
                        StrokeThickness="1"
                        Padding="20,24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#20000000" Offset="0,3" Radius="8" Opacity="0.15"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Image Source="price_tag_icon.svg" 
                               HeightRequest="40" 
                               WidthRequest="40" 
                               HorizontalOptions="Center"/>
                        <Label Text="Discount Settings"
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource Neutral950}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDiscountSettingsClicked"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- Income -->
                <Border BackgroundColor="{StaticResource NeutralWhite}" 
                        Stroke="{StaticResource Primary100}" 
                        StrokeThickness="1"
                        Padding="20,24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#20000000" Offset="0,3" Radius="8" Opacity="0.15"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Image Source="dollar_icon.svg" 
                               HeightRequest="40" 
                               WidthRequest="40" 
                               HorizontalOptions="Center"/>
                        <Label Text="Income"
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource Neutral950}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnIncomeClicked"/>
                    </Border.GestureRecognizers>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>