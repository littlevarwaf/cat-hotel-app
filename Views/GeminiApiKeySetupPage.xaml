<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatHotel.Views.GeminiApiKeySetupPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <StaticResource Key="PageBackgroundBrush" />
    </ContentPage.Background>

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Border Grid.Row="0" BackgroundColor="Transparent" Padding="16,0,32,0" MinimumHeightRequest="56"
                StrokeThickness="0" Margin="0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="0">
                <!-- Back Button -->
                <Button Grid.Column="0"
                        ImageSource="chevron_left.svg"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Neutral950}"
                        FontSize="28"
                        Padding="8,0"
                        Clicked="OnBackClicked"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"/>

                <!-- Title -->
                <Label Grid.Column="1"
                       Text="Gemini API Configuration"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Neutral950}"
                       HorizontalOptions="Center"
                       VerticalTextAlignment="Center"
                       HorizontalTextAlignment="Center"/>

                <!-- Paw Icon -->
                <Image Grid.Column="2"
                       Source="app_icon.svg"
                       HeightRequest="28"
                       WidthRequest="28"
                       HorizontalOptions="End"
                       VerticalOptions="Center"/>
            </Grid>
        </Border>

        <!-- FORM SCROLL -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,16,16,120" Spacing="0">

                <Label Text="API Configuration"
                       FontSize="16" FontAttributes="Bold"
                       TextColor="{StaticResource Neutral950}" Margin="0,0,0,12"/>

                <!-- Main Card with API Key Input -->
                <Border BackgroundColor="{StaticResource NeutralWhite}" Stroke="{StaticResource Primary100}" StrokeThickness="1"
                        Padding="16" Margin="0,0,0,24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#20000000" Offset="0,3" Radius="8" Opacity="0.15"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="24">

                        <!-- Instructions Card (Stroke Only) -->
                        <Border BackgroundColor="Transparent" Stroke="{StaticResource Primary500}" StrokeThickness="1" Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="8">
                                <Label Text="How to Get Your API Key:"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary500}"
                                       FontSize="12"/>
                                <Label Text="1. Visit https://aistudio.google.com/app/apikey"
                                       TextColor="{StaticResource Primary500}"
                                       FontSize="12"
                                       LineBreakMode="WordWrap"/>
                                <Label Text="2. Create a new API key"
                                       TextColor="{StaticResource Primary500}"
                                       FontSize="12"/>
                                <Label Text="3. Copy and paste your API key in the field below"
                                       TextColor="{StaticResource Primary500}"
                                       FontSize="12"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- API Key Field -->
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                <Image Grid.Column="0" Source="note_icon.svg" HeightRequest="16" WidthRequest="16"/>
                                <Label Grid.Column="1" Text="API Key"
                                       FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Neutral950}"/>
                            </Grid>
                            <Border Style="{StaticResource RoundedInputContainerStyle}">
                                <Entry x:Name="ApiKeyEntry"
                                       Placeholder="Paste your API key here"
                                       IsPassword="True"
                                       ClearButtonVisibility="WhileEditing"
                                       Style="{StaticResource RoundedEntryStyle}"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Security Note -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalOptions="Start" HorizontalOptions="Start">
                            <Image Grid.Column="0" Source="shield_check_icon.svg" WidthRequest="12" HeightRequest="12"/>
                            <Label Grid.Column="1" Text="Your API key is stored securely in the device's encrypted storage and never transmitted elsewhere."
                                   FontSize="11"
                                   TextColor="{StaticResource Neutral400}"
                                   LineBreakMode="WordWrap"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Status Message -->
                <Label x:Name="StatusLabel"
                       Text=""
                       TextColor="{StaticResource SemanticError}"
                       FontSize="12"
                       LineBreakMode="WordWrap"
                       Margin="0,0,0,24"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Gradient overlay behind buttons -->
        <BoxView Grid.Row="1" ZIndex="0" VerticalOptions="End" HeightRequest="128">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFF3E9" Offset="1" />
                    <GradientStop Color="#00FFF3E9" Offset="0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Button Stack at Bottom -->
        <StackLayout Grid.Row="1" ZIndex="1" Margin="30,0,30,40" VerticalOptions="End" Spacing="12">
            <!-- Save Button -->
            <Border BackgroundColor="{StaticResource Primary500}" StrokeThickness="0" Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28"/>
                </Border.StrokeShape>
                <Label Text="Save API Key" TextColor="{StaticResource NeutralWhite}" FontSize="16"
                       FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"
                       Padding="0,16"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSaveClicked"/>
                </Border.GestureRecognizers>
            </Border>
        </StackLayout>

    </Grid>
</ContentPage>