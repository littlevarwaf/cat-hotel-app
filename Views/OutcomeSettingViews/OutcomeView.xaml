<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatHotel.Views.OutcomeSettingViews.OutcomeView"
             BackgroundColor="{StaticResource PageBackgroundBrush}">

    <Grid RowDefinitions="*,Auto">

        <!-- FORM CONTENT -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,16,16,120" Spacing="0">

                <Label Text="Add Outcome"
                       FontSize="16" FontAttributes="Bold"
                       TextColor="#1A1A1A" Margin="0,0,0,12"/>

                <!-- Amount Card -->
                <Border BackgroundColor="{StaticResource NeutralWhite}"
                        Stroke="{StaticResource Primary100}" StrokeThickness="1"
                        Padding="16" Margin="0,0,0,16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#20000000" Offset="0,3" Radius="8" Opacity="0.15"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                            <Image Grid.Column="0" Source="dollar_icon.svg" HeightRequest="18" WidthRequest="18"/>
                            <Label Grid.Column="1" Text="Amount (ยอดเงิน)"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource Neutral950}"/>
                        </Grid>
                        <Border Style="{StaticResource RoundedInputContainerStyle}">
                            <Entry x:Name="AmountEntry"
                                   Placeholder="Enter amount (e.g. 500)"
                                   Keyboard="Numeric"
                                   Style="{StaticResource RoundedEntryStyle}"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Note Card -->
                <Border BackgroundColor="{StaticResource NeutralWhite}"
                        Stroke="{StaticResource Primary100}" StrokeThickness="1"
                        Padding="16" Margin="0,0,0,24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#20000000" Offset="0,3" Radius="8" Opacity="0.15"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                            <Image Grid.Column="0" Source="note_icon.svg" HeightRequest="18" WidthRequest="18"/>
                            <Label Grid.Column="1" Text="Note (หมายเหตุ)"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource Neutral950}"/>
                        </Grid>
                        <Border Style="{StaticResource RoundedInputContainerStyle}">
                            <Entry x:Name="NoteEntry"
                                    Placeholder="Enter note..."
                                    HeightRequest="100"
                                    Style="{StaticResource RoundedEntryStyle}"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Gradient overlay behind confirm button -->
        <BoxView Grid.Row="0" ZIndex="0" VerticalOptions="End" HeightRequest="128">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFF7EF" Offset="1" />
                    <GradientStop Color="#00FFF7EF" Offset="0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Floating Confirm Button -->
        <Border Grid.Row="0" ZIndex="1" Margin="30,0,30,40" HeightRequest="64"
                BackgroundColor="Transparent" StrokeThickness="0"
                VerticalOptions="End">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#E06060" Offset="0,4" Radius="12" Opacity="0.4" />
            </Border.Shadow>
            <Border BackgroundColor="{StaticResource Primary500}" StrokeThickness="0" Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="38"/>
                </Border.StrokeShape>
                <Label Text="Confirm" TextColor="White" FontSize="16"
                   FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnConfirmTapped"/>
                </Border.GestureRecognizers>
            </Border>
        </Border>

    </Grid>
</ContentView>