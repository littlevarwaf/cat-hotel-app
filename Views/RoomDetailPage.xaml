<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CatHotel.Views.Controls"
             x:Class="CatHotel.Views.RoomDetailPage"
             BackgroundColor="{StaticResource Primary50}">

    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*">

        <!-- Header -->
        <Border Grid.Row="0" BackgroundColor="Transparent" Padding="12" StrokeThickness="0" Margin="0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" 
                        ImageSource="chevron_left.svg" 
                        BackgroundColor="Transparent" 
                        TextColor="{StaticResource Neutral950}"
                        FontSize="24" Padding="0" 
                        Clicked="OnBackClicked"/>

                <StackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="8">
                    <Label Text="{Binding Booking.Room.Name, StringFormat='{0} - Booking Details'}"
                           FontSize="15" FontAttributes="Bold" 
                           TextColor="{StaticResource Neutral950}"
                           HorizontalOptions="Center"/>
                    <Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0" Padding="16,6" HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle Stroke="{StaticResource Primary900}" CornerRadius="999"/>
                        </Border.StrokeShape>
                        <Label Text="{Binding DateRangeDisplay}"
                               TextColor="{StaticResource Primary900}" FontSize="12" FontAttributes="Bold"/>
                    </Border>
                </StackLayout>

                <Image Grid.Column="2" 
                       Source="app_icon.svg" 
                       HeightRequest="32" WidthRequest="32"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollView Grid.Row="1" Padding="12,8,12,128">
            <StackLayout Spacing="16">

                <!-- Customer Details Section -->
                <Border BackgroundColor="{StaticResource NeutralWhite}" StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08"/>
                    </Border.Shadow>
                    <StackLayout Spacing="12">
                        <Label Text="Customer Details" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Neutral950}"/>

                        <!-- Customer Card or Add Button -->
                        <StackLayout Spacing="8">
                            <Frame x:Name="CustomerFrame" 
                                   Padding="12" CornerRadius="8" 
                                   HasShadow="False" 
                                   BorderColor="{StaticResource Neutral200}"
                                   BackgroundColor="{StaticResource NeutralWhite}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding EditCustomerCommand}"/>
                                </Frame.GestureRecognizers>
                                <Grid ColumnDefinitions="128,*" ColumnSpacing="12" HorizontalOptions="Fill">
                                    <!-- Customer Photo -->
                                    <Frame Grid.Column="0" 
                                           Padding="0"
                                           CornerRadius="8" 
                                           HasShadow="False"
                                           WidthRequest="128"
                                           HeightRequest="128">
                                        <Image Source="{Binding Customer.ImgUrl}" Aspect="AspectFit" WidthRequest="128" HeightRequest="128" BackgroundColor="{StaticResource Neutral200}" />
                                    </Frame>

                                    <!-- Customer Info -->
                                    <StackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center" HorizontalOptions="Fill">
                                        <Label Text="{Binding Customer.Name}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Neutral950}"/>

                                        <!-- Tel Row -->
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center" HorizontalOptions="Fill">
                                            <Image Grid.Column="0" Source="phone_icon.svg" HeightRequest="12" WidthRequest="12" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="Tel" FontSize="12" TextColor="{StaticResource Neutral950}" VerticalOptions="Center"/>
                                            <BoxView Grid.Column="2" BackgroundColor="Transparent"/>
                                            <Label Grid.Column="3" Text="{Binding Customer.TelephoneNum}" FontSize="14" TextColor="{StaticResource Neutral400}" VerticalOptions="Center" MaximumWidthRequest="108" LineBreakMode="TailTruncation"/>
                                        </Grid>

                                        <!-- Email Row -->
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center" HorizontalOptions="Fill">
                                            <Image Grid.Column="0" Source="mail_icon.svg" HeightRequest="12" WidthRequest="12" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="Email" FontSize="12" TextColor="{StaticResource Neutral950}" VerticalOptions="Center"/>
                                            <BoxView Grid.Column="2" BackgroundColor="Transparent"/>
                                            <Label Grid.Column="3" Text="{Binding Customer.Email}" FontSize="14" TextColor="{StaticResource Neutral400}" VerticalOptions="Center" MaximumWidthRequest="108" LineBreakMode="TailTruncation"/>
                                        </Grid>

                                        <!-- Line ID Row -->
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center" HorizontalOptions="Fill">
                                            <Image Grid.Column="0" Source="chat_icon.svg" HeightRequest="12" WidthRequest="12" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="Line ID" FontSize="12" TextColor="{StaticResource Neutral950}" VerticalOptions="Center"/>
                                            <BoxView Grid.Column="2" BackgroundColor="Transparent"/>
                                            <Label Grid.Column="3" Text="{Binding Customer.LineId}" FontSize="14" TextColor="{StaticResource Neutral400}" VerticalOptions="Center" MaximumWidthRequest="108" LineBreakMode="TailTruncation"/>
                                        </Grid>
                                    </StackLayout>
                                </Grid>
                            </Frame>
                        </StackLayout>
                    </StackLayout>
                </Border>

                <!-- Cat Details Section -->
                <Border BackgroundColor="{StaticResource NeutralWhite}" StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08"/>
                    </Border.Shadow>
                    <StackLayout Spacing="12">
                        <Label Text="Cat Details" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Neutral950}"/>

                        <!-- Cats List -->
                        <StackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Cats}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{StaticResource NeutralWhite}"
                                            StrokeThickness="1" 
                                            Stroke="{StaticResource Neutral200}"
                                            Padding="12" 
                                            HorizontalOptions="FillAndExpand">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12"/>
                                        </Border.StrokeShape>
                                        <Border.Shadow>
                                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08"/>
                                        </Border.Shadow>
                                        <StackLayout Spacing="8">
                                            <!-- Cat Card Content -->
                                            <Grid ColumnDefinitions="128,*" ColumnSpacing="12" HorizontalOptions="Fill">
                                                <!-- Cat Photo -->
                                                <Frame Grid.Column="0" 
                                                       Padding="0"
                                                       CornerRadius="8" 
                                                       HasShadow="False"
                                                       WidthRequest="128"
                                                       HeightRequest="128"
                                                       BackgroundColor="{StaticResource Neutral200}">
                                                    <Image Source="{Binding ImgUrl}" Aspect="AspectFill" WidthRequest="128" HeightRequest="128" />
                                                </Frame>

                                                <!-- Cat Info -->
                                                <StackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center" HorizontalOptions="Fill">
                                                    <Label Text="{Binding Name}" 
                                                           FontSize="16" 
                                                           FontAttributes="Bold" 
                                                           TextColor="{StaticResource Neutral950}"/>

                                                    <!-- Age Row -->
                                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center" HorizontalOptions="Fill">
                                                        <Image Grid.Column="0" Source="calendar_icon.svg" HeightRequest="12" WidthRequest="12" VerticalOptions="Center"/>
                                                        <Label Grid.Column="1" Text="Age" FontSize="12" TextColor="{StaticResource Neutral950}" VerticalOptions="Center"/>
                                                        <BoxView Grid.Column="2" BackgroundColor="Transparent"/>
                                                        <Label Grid.Column="3" Text="{Binding Age, StringFormat='{0} years'}" FontSize="14" TextColor="{StaticResource Neutral400}" VerticalOptions="Center"/>
                                                    </Grid>

                                                    <!-- Gender Row -->
                                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center" HorizontalOptions="Fill">
                                                        <Image Grid.Column="0" Source="heart_icon.svg" HeightRequest="12" WidthRequest="12" VerticalOptions="Center"/>
                                                        <Label Grid.Column="1" Text="Gender" FontSize="12" TextColor="{StaticResource Neutral950}" VerticalOptions="Center"/>
                                                        <BoxView Grid.Column="2" BackgroundColor="Transparent"/>
                                                        <Label Grid.Column="3" Text="{Binding Gender}" FontSize="14" TextColor="{StaticResource Neutral400}" VerticalOptions="Center"/>
                                                    </Grid>

                                                    <!-- Breed Row -->
                                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center" HorizontalOptions="Fill">
                                                        <Image Grid.Column="0" Source="star_icon.svg" HeightRequest="12" WidthRequest="12" VerticalOptions="Center"/>
                                                        <Label Grid.Column="1" Text="Breed" FontSize="12" TextColor="{StaticResource Neutral950}" VerticalOptions="Center"/>
                                                        <BoxView Grid.Column="2" BackgroundColor="Transparent"/>
                                                        <Label Grid.Column="3" Text="{Binding Breed}" FontSize="14" TextColor="{StaticResource Neutral400}" VerticalOptions="Center" MaximumWidthRequest="108" LineBreakMode="TailTruncation"/>
                                                    </Grid>
                                                </StackLayout>
                                            </Grid>

                                            <!-- Action Buttons Row -->
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <!-- Edit Button -->
                                                <Border Grid.Column="0" 
                                                        StrokeThickness="1" 
                                                        Stroke="{StaticResource Primary100}"
                                                        BackgroundColor="{StaticResource NeutralWhite}" 
                                                        Padding="0,8"
                                                        HorizontalOptions="Fill">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="8"/>
                                                    </Border.StrokeShape>
                                                    <Label Text="Edit" 
                                                           FontSize="12"
                                                           TextColor="{StaticResource Primary700}" 
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center"/>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer 
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.EditCatCommand}" 
                                                            CommandParameter="{Binding .}"/>
                                                    </Border.GestureRecognizers>
                                                </Border>

                                                <!-- Remove Button -->
                                                <Border Grid.Column="1" 
                                                        StrokeThickness="1" 
                                                        Stroke="{StaticResource Neutral200}"
                                                        BackgroundColor="{StaticResource Neutral100}" 
                                                        Padding="0,8"
                                                        WidthRequest="80">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="8"/>
                                                    </Border.StrokeShape>
                                                    <Label Text="Remove" 
                                                           FontSize="12"
                                                           TextColor="{StaticResource Neutral600}" 
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center"/>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer 
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.RemoveCatCommand}" 
                                                            CommandParameter="{Binding .}"/>
                                                    </Border.GestureRecognizers>
                                                </Border>
                                            </Grid>
                                        </StackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>

                        <!-- Add More Cats Button -->
                        <Button x:Name="AddMoreCatsButton"
                                ImageSource="add_plus_icon_square.svg"
                                Text="+ Add More Cats"
                                BackgroundColor="{StaticResource NeutralWhite}"
                                TextColor="{StaticResource Neutral950}"
                                BorderColor="{StaticResource Primary500}"
                                BorderWidth="0.25"
                                CornerRadius="8"
                                FontSize="14"
                                HeightRequest="48"
                                Command="{Binding AddMoreCatsCommand}"
                                IsVisible="{Binding CanAddMoreCats}"/>
                    </StackLayout>
                </Border>

                <!-- Booking Charges & Payments Section -->
                <Border BackgroundColor="{StaticResource NeutralWhite}" StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08"/>
                    </Border.Shadow>
                    <StackLayout Spacing="12">
                        <Label Text="Booking Charges &amp; Payments" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Neutral950}"/>

                        <!-- Pre-paid Items (Room Charge) -->
                        <StackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackLayout Grid.Column="0" Spacing="2">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center" HorizontalOptions="Fill">
                                        <Image Grid.Column="0" Source="circle_check_icon.svg" HeightRequest="12" WidthRequest="12" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="Room Total" FontSize="13" TextColor="{StaticResource Neutral950}" VerticalOptions="Center"/>
                                        <BoxView Grid.Column="2" BackgroundColor="Transparent"/>
                                        <Label Grid.Column="3" Text="{Binding Booking.TotalPrice, StringFormat='฿ {0:N0}'}" FontSize="13" TextColor="{StaticResource Primary500}" VerticalOptions="Center"/>
                                    </Grid>
                                    <Label Text="{Binding RoomChargeDescription}" 
                                           FontSize="12" TextColor="{StaticResource Neutral600}"/>
                                </StackLayout>
                            </Grid>
                        </StackLayout>

                        <!-- Shop Items -->
                        <StackLayout Spacing="8">
                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" VerticalOptions="Center" HorizontalOptions="Fill">
                                <Image Grid.Column="0" Source="price_tag_icon.svg" HeightRequest="12" WidthRequest="12" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="Added from Shop" FontSize="13" TextColor="{StaticResource Neutral950}" VerticalOptions="Center"/>
                                <BoxView Grid.Column="2" BackgroundColor="Transparent"/>
                            </Grid>
                            <StackLayout BindableLayout.ItemsSource="{Binding BookingItems}" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding ShopItem.Name, StringFormat='{0}'}" 
                                                       FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Neutral950}"/>
                                                <Label Text="{Binding Quantity, StringFormat='Qty: {0}'}" 
                                                       FontSize="11" TextColor="{StaticResource Neutral600}"/>
                                            </StackLayout>
                                            <StackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                                                <Label Text="{Binding UnitPrice, StringFormat='฿ {0:N0}'}" 
                                                       FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary700}" HorizontalTextAlignment="End"/>
                                                <Label Text="{Binding Subtotal, StringFormat='Subtotal: ฿ {0:N0}'}" 
                                                       FontSize="11" TextColor="{StaticResource Neutral600}"/>
                                            </StackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </StackLayout>
                        </StackLayout>

                        <!-- Discount Code Entry (Hidden when discount applied) -->
                        <StackLayout x:Name="DiscountEntrySection" Spacing="6" Margin="0,16,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackLayout Grid.Column="0" Spacing="2">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center" HorizontalOptions="Fill">
                                        <Image Grid.Column="0" Source="discount_code_icon.png" HeightRequest="12" WidthRequest="12" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="Discount Code" FontSize="13" TextColor="{StaticResource Neutral950}" VerticalOptions="Center"/>
                                    </Grid>
                                </StackLayout>
                            </Grid>
                            <Border Style="{StaticResource RoundedInputContainerStyle}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <Entry x:Name="DiscountCodeEntry"
                                           Grid.Column="0" 
                                           Placeholder="Enter Discount Code..."
                                           Style="{StaticResource RoundedEntryStyle}"
                                           Text="{Binding DiscountCodeInput}"/>
                                    <Button x:Name="ApplyDiscountButton"
                                            Grid.Column="1"
                                            Text="APPLY" 
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource Primary500}" 
                                            FontSize="12" 
                                            FontAttributes="Bold"
                                            Padding="0"
                                            HorizontalOptions="Start"
                                            Command="{Binding ApplyDiscountCommand}"/>
                                </Grid>
                            </Border>
                        </StackLayout>

                        <!-- Applied Discount Card (Hidden when no discount) -->
                        <Border x:Name="AppliedDiscountCard"
                                BackgroundColor="White" 
                                Stroke="{StaticResource Primary500}"
                                StrokeThickness="1" 
                                Padding="16"
                                Margin="0,16,0,0"
                                IsVisible="False">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#20000000" Offset="0,2" Radius="6" Opacity="0.12"/>
                            </Border.Shadow>

                            <!-- Main Grid: 2 Rows -->
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">

                                <!-- Row 1: 2-Column Grid (Description/Code on left, Amount on right) -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalOptions="Center">
                                    <!-- Left Column: Description and Code -->
                                    <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                        <Label Text="{Binding AppliedDiscount.Description}"
                                               FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Neutral600}"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding AppliedDiscount.Code}"
                                               FontSize="20" FontAttributes="Bold"
                                               TextColor="{StaticResource Primary500}" 
                                               LineBreakMode="TailTruncation"/>
                                    </VerticalStackLayout>

                                    <!-- Right Column: Amount -->
                                    <Label Grid.Column="1"
                                           Text="{Binding AppliedDiscount.Amount, StringFormat='฿{0:N0}'}"
                                           FontSize="24" FontAttributes="Bold"
                                           TextColor="{StaticResource Neutral950}"
                                           HorizontalTextAlignment="End"
                                           VerticalOptions="End"/>
                                </Grid>

                                <!-- Row 2: Bottom Row (Expiration Date on left, Remove Button on right) -->
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalOptions="Center">
                                    <!-- Left Column: Expiration Date -->
                                    <Label Grid.Column="0"
                                           Text="{Binding AppliedDiscount.ExpirationDate, StringFormat='Expires: {0:MMM dd, yyyy}'}"
                                           FontSize="11" TextColor="#9E9090"
                                           VerticalOptions="Center"/>

                                    <!-- Right Column: Remove Button -->
                                    <Button Grid.Column="1"
                                            Text="Remove" 
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource Primary500}"
                                            FontSize="11"
                                            Padding="0"
                                            HeightRequest="16"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            Command="{Binding RemoveDiscountCommand}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Total Section -->
                        <Border BackgroundColor="{StaticResource Primary50}" StrokeThickness="0" Padding="12,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <StackLayout Spacing="4">
                                <!-- Subtotal (always shown) -->
                                <Grid ColumnDefinitions="*,Auto" x:Name="SubtotalRow">
                                    <Label Grid.Column="0"
                                           Text="Subtotal" 
                                           FontSize="12"
                                           TextColor="{StaticResource Neutral600}"
                                           VerticalOptions="Center"/>
                                    <Label Grid.Column="1"
                                           Text="{Binding TotalPrice, StringFormat='฿{0:N0}'}" 
                                           FontSize="12"
                                           TextColor="{StaticResource Neutral600}"/>
                                </Grid>

                                <!-- Early Check-Out Adjustment (shown only if there's an adjustment) -->
                                <Grid ColumnDefinitions="*,Auto" x:Name="EarlyCheckOutRow" IsVisible="{Binding HasEarlyCheckOut}">
                                    <Label Grid.Column="0"
                                           Text="Early Check-Out Adjustment" 
                                           FontSize="12"
                                           TextColor="#DC2626"
                                           VerticalOptions="Center"/>
                                    <Label Grid.Column="1"
                                           Text="{Binding EarlyCheckOutAdjustment, StringFormat='{0:฿ #,##0.00}'}" 
                                           FontSize="12"
                                           TextColor="#DC2626"/>
                                </Grid>

                                <!-- Discount Amount (if applied) -->
                                <Grid ColumnDefinitions="*,Auto" x:Name="DiscountRow" IsVisible="{Binding HasAppliedDiscount}">
                                    <Label Grid.Column="0"
                                           Text="Discount" 
                                           FontSize="12"
                                           TextColor="#DC2626"
                                           VerticalOptions="Center"/>
                                    <Label Grid.Column="1"
                                           Text="{Binding DiscountAmount, StringFormat='-฿{0:N0}'}" 
                                           FontSize="12"
                                           TextColor="#DC2626"/>
                                </Grid>

                                <!-- Final Total -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" 
                                           Text="Total" 
                                           FontSize="15" FontAttributes="Bold" 
                                           TextColor="{StaticResource Neutral950}"
                                           VerticalOptions="Center"/>
                                    <Label Grid.Column="1" 
                                           Text="{Binding FinalTotalPrice, StringFormat='฿{0:N0}'}" 
                                           FontSize="18" FontAttributes="Bold" 
                                           TextColor="{StaticResource Primary700}"/>
                                </Grid>
                            </StackLayout>
                        </Border>
                    </StackLayout>
                </Border>

                <!-- Checkout Button -->
                <Border BackgroundColor="Transparent" StrokeThickness="0" Padding="12,8">
                    <Button Text="✓ Check Out and Pay"
                            BackgroundColor="{StaticResource Primary500}" 
                            TextColor="{StaticResource NeutralWhite}"
                            CornerRadius="38" 
                            FontSize="16" 
                            HeightRequest="64"
                            Command="{Binding CheckoutCommand}"/>
                </Border>
            </StackLayout>
        </ScrollView>


    </Grid>
</ContentView>