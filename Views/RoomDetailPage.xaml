<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatHotel.Views.RoomDetailPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#FFF5F5"
             Title="Room Detail">

    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" BackgroundColor="White" Padding="12"
                StrokeThickness="0" Margin="0">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.1"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Text="‹" BackgroundColor="Transparent" TextColor="#212121"
                        FontSize="24" Padding="0" Clicked="OnBackClicked"/>
                <StackLayout Grid.Column="1" HorizontalOptions="Center">
                    <Label x:Name="RoomIdLabel" Text="Room - Booking Details"
                           FontSize="15" FontAttributes="Bold" TextColor="#212121"
                           HorizontalOptions="Center"/>
                    <Border BackgroundColor="#FCE4EC" StrokeThickness="0"
                            Padding="8,4" HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Label x:Name="RoomTypeLabel" Text="" TextColor="#E91E63" FontSize="12"/>
                    </Border>
                </StackLayout>
                <Label Grid.Column="2" Text="🐾" FontSize="24" VerticalOptions="Center"/>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" Padding="12,8">
            <StackLayout Spacing="12">

                <Border BackgroundColor="White" StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08"/>
                    </Border.Shadow>
                    <StackLayout Spacing="8">
                        <Label Text="Room Info" FontSize="15" FontAttributes="Bold" TextColor="#212121"/>
                        <Label x:Name="BasePriceLabel" Text="" FontSize="13" TextColor="#E91E63"/>
                        <Label Text="(Customer &amp; Cat info will appear here)"
                               FontSize="12" TextColor="#BDBDBD" FontAttributes="Italic"/>
                    </StackLayout>
                </Border>

                <Button Text="✓  Check Out and Pay"
                        BackgroundColor="#E91E63" TextColor="White"
                        CornerRadius="12" FontSize="16" HeightRequest="52"
                        Margin="0,4,0,8" Clicked="OnCheckout"/>
            </StackLayout>
        </ScrollView>

        <Border Grid.Row="2" BackgroundColor="Transparent" StrokeThickness="0"
                Padding="12,8,12,16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                <Border Grid.Column="0" BackgroundColor="White" StrokeThickness="0"
                        HorizontalOptions="Fill" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="10" Opacity="0.12"/>
                    </Border.Shadow>
                    <Grid ColumnDefinitions="*,*" Padding="6,6">
                        <Border Grid.Column="0" BackgroundColor="#FCE4EC" StrokeThickness="0"
                                Margin="2" Padding="0,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="🏠" FontSize="18" HorizontalOptions="Center"/>
                                <Label Text="Room Details" FontSize="11" TextColor="#E91E63"
                                       FontAttributes="Bold" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="Transparent" StrokeThickness="0"
                                Margin="2" Padding="0,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpenShopTapped"/>
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="🛍" FontSize="18" HorizontalOptions="Center"/>
                                <Label Text="Shop" FontSize="11" TextColor="#757575"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" WidthRequest="56" HeightRequest="56" VerticalOptions="Center">
                    <Border BackgroundColor="White" StrokeThickness="0"
                            WidthRequest="56" HeightRequest="56"
                            HorizontalOptions="Center" VerticalOptions="Center">
                        <Border.StrokeShape>
                            <Ellipse/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="10" Opacity="0.12"/>
                        </Border.Shadow>
                        <Button Text="🛒" BackgroundColor="Transparent" TextColor="#212121"
                                FontSize="22" Padding="0" Clicked="OnOpenCartClicked"/>
                    </Border>
                    <Border x:Name="CartBadge" BackgroundColor="#E91E63"
                            WidthRequest="22" HeightRequest="22" StrokeThickness="0"
                            HorizontalOptions="End" VerticalOptions="Start"
                            Margin="0,-4,-4,0" IsVisible="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="11"/>
                        </Border.StrokeShape>
                        <Label x:Name="CartCountLabel" Text="0" TextColor="White"
                               FontSize="10" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
