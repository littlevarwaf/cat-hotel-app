<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatHotel.Views.RoomDetailPage"
             BackgroundColor="#FFF5F5">

    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" BackgroundColor="White" Padding="12"
                StrokeThickness="0" Margin="0">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.1"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" ImageSource="chevron_left.svg" BackgroundColor="Transparent" TextColor="{StaticResource Neutral950}"
                        FontSize="24" Padding="0" Clicked="OnBackClicked"/>
                <StackLayout Grid.Column="1" HorizontalOptions="Center">
                    <!-- BIND TO Room.Name -->
                    <Label Text="{Binding Room.Name, StringFormat='{0} - Booking Details'}"
                           FontSize="15" FontAttributes="Bold" TextColor="#212121"
                           HorizontalOptions="Center"/>
                    <Border BackgroundColor="#FCE4EC" StrokeThickness="0"
                            Padding="8,4" HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <!-- BIND TO Room.RoomType -->
                        <Label Text="{Binding Room.RoomType, StringFormat='{0}'}" 
                               TextColor="#E91E63" FontSize="12"/>
                    </Border>
                </StackLayout>
                <Image Grid.Column="2" Source="app_icon.svg" HeightRequest="32" WidthRequest="32"/>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" Padding="12,8,8,128">
            <StackLayout Spacing="12">

                <Border BackgroundColor="White" StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08"/>
                    </Border.Shadow>
                    <StackLayout Spacing="8">
                        <Label Text="Room Info" FontSize="15" FontAttributes="Bold" TextColor="#212121"/>
                        <!-- BIND TO Room.BasePrice -->
                        <Label Text="{Binding Room.BasePrice, StringFormat='Base Price: ฿{0:N0} / night'}" 
                               FontSize="13" TextColor="#E91E63"/>
                        <Label Text="(Customer &amp; Cat info will appear here)"
                               FontSize="12" TextColor="#BDBDBD" FontAttributes="Italic"/>
                    </StackLayout>
                </Border>

                <Button Text="✓  Check Out and Pay"
                        BackgroundColor="#E91E63" TextColor="White"
                        CornerRadius="12" FontSize="16" HeightRequest="52"
                        Margin="0,4,0,8" Clicked="OnCheckout"/>
            </StackLayout>
        </ScrollView>

    </Grid>
</ContentView>