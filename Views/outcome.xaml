<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatHotel.Views.outcome"
             Title="Outcome"
             BackgroundColor="{StaticResource PageBackgroundBrush}">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">

        <!-- Header -->
        <Border Grid.Row="0" BackgroundColor="White" Padding="12,10" StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.08"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="Outcome" FontSize="20" FontAttributes="Bold"
                       TextColor="#212121" VerticalOptions="Center"/>
                <Image Grid.Column="1" Source="app_icon.svg" HeightRequest="32" WidthRequest="32"/>
            </Grid>
        </Border>

        <!-- Tab Buttons (pill style) -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" Padding="16,12,16,0" ColumnSpacing="10">

            <!-- Add Income — ACTIVE -->
            <Border Grid.Column="0" StrokeThickness="0"
                    BackgroundColor="{StaticResource Primary}" Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="25"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="8" Opacity="0.35"/>
                </Border.Shadow>
                <Button x:Name="BtnAddIncome"
                        Text="Add Income"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="14"
                        HeightRequest="44"
                        Clicked="OnAddIncomeClicked"/>
            </Border>

            <!-- History Income — INACTIVE -->
            <Border Grid.Column="1" StrokeThickness="1.5" Stroke="#E0E0E0"
                    BackgroundColor="White" Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="25"/>
                </Border.StrokeShape>
                <Button x:Name="BtnHistoryIncome"
                        Text="History Income"
                        BackgroundColor="Transparent"
                        TextColor="Black"
                        FontAttributes="None"
                        FontSize="14"
                        HeightRequest="44"
                        Clicked="OnHistoryIncomeClicked"/>
            </Border>
        </Grid>

        <!-- FORM CONTENT -->
        <Grid Grid.Row="2" RowDefinitions="*,Auto">

            <ScrollView Grid.Row="0">
                <VerticalStackLayout Padding="16,16,16,24" Spacing="0">

                    <Label Text="Add Outcome"
                           FontSize="16" FontAttributes="Bold"
                           TextColor="#1A1A1A" Margin="0,0,0,14"/>

                    <!-- Amount Card -->
                    <Border BackgroundColor="{StaticResource NeutralWhite}"
                            Stroke="{StaticResource Primary100}" StrokeThickness="1"
                            Padding="16" Margin="0,0,0,14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#20000000" Offset="0,3" Radius="8" Opacity="0.15"/>
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                <Image Grid.Column="0" Source="dollar_icon.svg" HeightRequest="18" WidthRequest="18"/>
                                <Label Grid.Column="1" Text="Amount (ยอดเงิน)"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource Neutral950}"/>
                            </Grid>
                            <Border Style="{StaticResource RoundedInputContainerStyle}">
                                <Entry x:Name="AmountEntry"
                                       Placeholder="Enter amount (e.g. 500)"
                                       Keyboard="Numeric"
                                       Style="{StaticResource RoundedEntryStyle}"/>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Note Card -->
                    <Border BackgroundColor="{StaticResource NeutralWhite}"
                            Stroke="{StaticResource Primary100}" StrokeThickness="1"
                            Padding="16" Margin="0,0,0,120">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#20000000" Offset="0,3" Radius="8" Opacity="0.15"/>
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                <Image Grid.Column="0" Source="note_icon.svg" HeightRequest="18" WidthRequest="18"/>
                                <Label Grid.Column="1" Text="Note (หมายเหตุ)"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource Neutral950}"/>
                            </Grid>
                            <Border Stroke="{StaticResource Primary100}" StrokeThickness="1"
                                    BackgroundColor="{StaticResource NeutralWhite}" Padding="2">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Editor x:Name="NoteEditor"
                                        Placeholder="Enter note / หมายเหตุ..."
                                        HeightRequest="100"
                                        Margin="8,4"
                                        TextColor="{StaticResource Neutral950}"
                                        PlaceholderColor="{StaticResource Neutral400}"
                                        FontSize="14"
                                        BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <!-- Gradient overlay -->
            <BoxView Grid.Row="0" ZIndex="0" VerticalOptions="End" HeightRequest="110">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFF7EF" Offset="1"/>
                        <GradientStop Color="#00FFF7EF" Offset="0"/>
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <!-- Confirm Button -->
            <Border Grid.Row="0" ZIndex="1" Margin="30,0,30,32" HeightRequest="54"
                    BackgroundColor="Transparent" StrokeThickness="0"
                    VerticalOptions="End">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="27"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#E06060" Offset="0,4" Radius="12" Opacity="0.4"/>
                </Border.Shadow>
                <Border BackgroundColor="{StaticResource Primary500}" StrokeThickness="0" Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="27"/>
                    </Border.StrokeShape>
                    <Label Text="ยืนยัน / Confirm"
                           TextColor="White" FontSize="16"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnConfirmTapped"/>
                    </Border.GestureRecognizers>
                </Border>
            </Border>

        </Grid>

    </Grid>
</ContentPage>
