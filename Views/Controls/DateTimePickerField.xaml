<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatHotel.Views.Controls.DateTimePickerField"
             x:Name="Root">

    <VerticalStackLayout Spacing="8">
        <Label x:Name="TitleLabel" Text="วันที่และเวลา"
               FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Neutral950}"/>
        <Border Style="{StaticResource RoundedPickerContainerStyle}">
            <DatePicker x:Name="DatePart"
                        Style="{StaticResource RoundedPickerStyle}"
                        DateSelected="OnPartChanged"/>
        </Border>
        <Border Style="{StaticResource RoundedPickerContainerStyle}">
            <TimePicker x:Name="TimePart"
                        Format="HH:mm"
                        PropertyChanged="OnTimePartPropertyChanged"/>
        </Border>
        <Label x:Name="SummaryLabel"
               FontSize="12"
               TextColor="#E91E63"
               Text="{Binding Source={x:Reference Root}, Path=DisplayText}"/>
    </VerticalStackLayout>
</ContentView>
