<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="CatHotel.Views.Sales" x:Name="SalesView">

    <ContentView.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F7D7D7" Offset="0.0" />
            <GradientStop Color="#FBEAEA" Offset="0.25" />
            <GradientStop Color="#FFF7EF" Offset="1.0" />
        </LinearGradientBrush>
    </ContentView.Background>
    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" BackgroundColor="White" Padding="16,12" MinimumHeightRequest="64" MaximumHeightRequest="64"
                StrokeThickness="0" Margin="0">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.1"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Label Text="Sales Dashboard" FontSize="22" FontAttributes="Bold"
                       TextColor="#212121" VerticalOptions="Center"/>
                <Image Grid.Column="2" Source="app_icon.svg" HeightRequest="32" WidthRequest="32"/>
            </Grid>
        </Border>

        <!-- ตัวกราฟ -->
        <ScrollView Grid.Row="1" Padding="0,0,0,128">

            <VerticalStackLayout Padding="16" Spacing="12">
                <!-- ตัวกราฟแท่ง -->
                <Label Text="รายได้ปัจจุบัน" FontSize="14" FontAttributes="Bold" />
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8" Margin="0,8,0,8">
                    <Button Text="◀"
                    WidthRequest="36" HeightRequest="36"
                    Clicked="PrevYearButton_Clicked"/>
                    <Label Text="{Binding SelectedYear}"   
                FontSize="20"
                   VerticalTextAlignment="Center"
                   HorizontalOptions="Center"/>
                    <Button Text="▶"
                        WidthRequest="36" HeightRequest="36"
                        Clicked="NextYearButton_Clicked"/>
                </HorizontalStackLayout>
                <Border Padding="12"
        StrokeShape="RoundRectangle 8"
        StrokeThickness="1"
        HeightRequest="280"
        BackgroundColor="White">
                    <microcharts:ChartView x:Name="Income7MonthsChart"
                           HorizontalOptions="FillAndExpand"
                           VerticalOptions="FillAndExpand" Margin="0,0,0,0" />
                </Border>

                <!-- แถวเดือนอยู่ใต้กราฟ -->
                <HorizontalStackLayout Spacing="0" HorizontalOptions="Center" Padding="0,0,0,0">
                    <Label Text="" WidthRequest="5"/>
                    <HorizontalStackLayout Spacing="5"
                                   BindableLayout.ItemsSource="{Binding MonthLabels, Source={x:Reference SalesView}}" >
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding .}" WidthRequest="55" HorizontalTextAlignment="Center"/>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                    <Label Text="" WidthRequest="0"/>
                </HorizontalStackLayout>

                <!-- แถวปุ่มเลื่อน (ต่ำกว่าชื่อเดือน) -->
                <HorizontalStackLayout Spacing="12" HorizontalOptions="Center" Padding="0,8">
                    <Button Text="Jan - Jun" Padding="0" WidthRequest="70" HeightRequest="36" Clicked="PrevButton_Clicked"/>
                    <Button Text="Jul - Dec" Padding="0" WidthRequest="70" HeightRequest="36" Clicked="NextButton_Clicked"/>
                </HorizontalStackLayout>

                <!-- ตัวกราฟโดนัท -->
                <Label Text="ประเภทสินค้าขายดี (รายเดือน)"
                       FontSize="14"
                       FontAttributes="Bold" />
                <Grid>
                    <Border Stroke="#6B3A3A"
                    StrokeThickness="1"
                    BackgroundColor="#F3A7A7"
                    Padding="14,10"
                    StrokeShape="RoundRectangle 999"
                    HorizontalOptions="Start">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Text="˅"
                           FontSize="18"
                           TextColor="#4A2A2A"
                           VerticalTextAlignment="Center" />

                            <Label x:Name="MonthDisplayLabel"
                           Grid.Column="1"
                           Text="Month: -"
                           FontSize="14"
                           TextColor="#4A2A2A"
                           VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>

                    <Picker x:Name="MonthPicker"
                    Opacity="0.01"
                    BackgroundColor="Transparent"
                    Title="เลือกเดือน"
                    SelectedIndexChanged="MonthPicker_SelectedIndexChanged" />
                </Grid>

                <Border Padding="6"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="1"
                HeightRequest="280"
                BackgroundColor="White">
                    <microcharts:ChartView x:Name="BestCategoryDonutChart"
                                   HorizontalOptions="FillAndExpand"
                                   VerticalOptions="FillAndExpand" />
                </Border>

                <!-- กราฟแท่งแสดงห้องที่มีการใช้ -->
                <Label Text="การใช้งานห้อง (รายเดือน)"
                       FontSize="14"
                       FontAttributes="Bold" />

                <Grid>
                    <Border Stroke="#6B3A3A"
                            StrokeThickness="1"
                            BackgroundColor="#F3A7A7"
                            Padding="14,10"
                            StrokeShape="RoundRectangle 999"
                            HorizontalOptions="Start">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Text="˅"
                                   FontSize="18"
                                   TextColor="#4A2A2A"
                                   VerticalTextAlignment="Center"/>

                            <Label x:Name="RoomMonthDisplayLabel"
                                   Grid.Column="1"
                                   Text="Month: -"
                                   FontSize="14"
                                   TextColor="#4A2A2A"
                                   VerticalTextAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Picker x:Name="RoomMonthPicker"
                            Opacity="0.01"
                            BackgroundColor="Transparent"
                            Title="เลือกเดือน"
                            SelectedIndexChanged="RoomMonthPicker_SelectedIndexChanged"/>
                </Grid>
                <Border Padding="12"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="1"
                        HeightRequest="260"
                        BackgroundColor="White">
                    <microcharts:ChartView x:Name="RoomUsageBarChart"
                           HorizontalOptions="FillAndExpand"
                           VerticalOptions="FillAndExpand" />
                </Border>

            </VerticalStackLayout>
        
        </ScrollView>

    </Grid>
</ContentView>