<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:CatHotel.Views"
             xmlns:conv="clr-namespace:CatHotel.Converters"
             x:Class="CatHotel.Views.CalendarPage"
             BackgroundColor="#FFF5F5">

    <ContentView.Resources>
        <conv:RoomStatusToColorConverter x:Key="StatusToColorConverter" />
        <conv:RoomStatusToStringConverter x:Key="StatusToStringConverter" />
        <conv:RoomTypeToStringConverter x:Key="RoomTypeToStringConverter" />
    </ContentView.Resources>

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" BackgroundColor="White" Padding="16,12" MinimumHeightRequest="64" MaximumHeightRequest="64"
                StrokeThickness="0" Margin="0">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.1"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Schedule a Stay" FontSize="22" FontAttributes="Bold"
                       TextColor="#212121" VerticalOptions="Center"/>
                <Image Grid.Column="2" Source="app_icon.svg" HeightRequest="32" WidthRequest="32"/>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" Padding="12,8,8,128">
            <StackLayout Spacing="10">

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4">
                    <Border BackgroundColor="{StaticResource Primary500}" StrokeThickness="0" Padding="10,6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Label x:Name="AvailableRoomsCountLabel" Text="Available Rooms: -"
                               TextColor="{StaticResource NeutralWhite}" FontSize="13" HorizontalOptions="Center"/>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="{StaticResource NeutralWhite}" StrokeThickness="1"
                            Stroke="{StaticResource Primary100}" Padding="10,6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Label x:Name="TotalRoomsLabel" Text="Total Rooms: -"
                               TextColor="{StaticResource Primary500}" FontSize="13" HorizontalOptions="Center"/>
                    </Border>
                </Grid>

                <Border BackgroundColor="White" StrokeThickness="0" Padding="12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.08"/>
                    </Border.Shadow>
                    <StackLayout Spacing="6">

                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button Text="‹" FontSize="22" BackgroundColor="Transparent"
                                    TextColor="{StaticResource Primary500}" Padding="0" WidthRequest="40"
                                    Clicked="OnPrevMonth"/>
                            <Label x:Name="MonthYearLabel" Grid.Column="1"
                                   Text="-" FontSize="17" FontAttributes="Bold"
                                   TextColor="{StaticResource Neutral950}"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Button Grid.Column="2" Text="›" FontSize="22"
                                    BackgroundColor="Transparent" TextColor="{StaticResource Primary500}"
                                    Padding="0" WidthRequest="40"
                                    Clicked="OnNextMonth"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                            <Label Text="Mon" FontSize="11" TextColor="#9E9E9E" HorizontalOptions="Center"/>
                            <Label Grid.Column="1" Text="Tue" FontSize="11" TextColor="{StaticResource Neutral400}" HorizontalOptions="Center"/>
                            <Label Grid.Column="2" Text="Wed" FontSize="11" TextColor="{StaticResource Neutral400}" HorizontalOptions="Center"/>
                            <Label Grid.Column="3" Text="Thu" FontSize="11" TextColor="{StaticResource Neutral400}" HorizontalOptions="Center"/>
                            <Label Grid.Column="4" Text="Fri" FontSize="11" TextColor="{StaticResource Neutral400}" HorizontalOptions="Center"/>
                            <Label Grid.Column="5" Text="Sat" FontSize="11" TextColor="{StaticResource Primary500}" HorizontalOptions="Center"/>
                            <Label Grid.Column="6" Text="Sun" FontSize="11" TextColor="{StaticResource Primary500}" HorizontalOptions="Center"/>
                        </Grid>

                        <Grid x:Name="CalendarDaysGrid"/>

                        <StackLayout Orientation="Horizontal" Spacing="16"
                                     HorizontalOptions="Center" Margin="0,4,0,0">
                            <StackLayout Orientation="Horizontal" Spacing="4">
                                <BoxView Color="{StaticResource SemanticWarning}" BackgroundColor="Transparent" CornerRadius="5"
                                         WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                                <Label Text="มีการจอง" FontSize="11" TextColor="#757575" VerticalOptions="Center"/>
                            </StackLayout>
                            <StackLayout Orientation="Horizontal" Spacing="4">
                                <BoxView Color="{StaticResource Primary}" BackgroundColor="Transparent" CornerRadius="5"
                                         WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                                <Label Text="วันที่เลือก" FontSize="11" TextColor="#757575" VerticalOptions="Center"/>
                            </StackLayout>
                            <StackLayout Orientation="Horizontal" Spacing="4">
                                <BoxView Color="{StaticResource SemanticError}" BackgroundColor="Transparent" CornerRadius="5"
                                         WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                                <Label Text="จองเต็ม" FontSize="11" TextColor="#757575" VerticalOptions="Center"/>
                            </StackLayout>
                        </StackLayout>

                    </StackLayout>
                </Border>

                <!-- Available Rooms Section Header -->
                <Grid ColumnDefinitions="*,Auto" Margin="4,16,4,8">
                    <Label Text="Available Rooms" FontSize="14" FontAttributes="Bold"
                           TextColor="{StaticResource Neutral950}" VerticalOptions="Center"/>
                    <Label x:Name="AvailableDateLabel" Grid.Column="1" Text=""
                           FontSize="12" TextColor="{StaticResource Neutral600}" 
                           VerticalOptions="Center" HorizontalTextAlignment="End"/>
                </Grid>

                <CollectionView x:Name="AvailableRoomsCollection" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="views:RoomViewModel">
                            <Border BackgroundColor="White" 
                                    StrokeThickness="2" 
                                    Stroke="{StaticResource Primary100}" 
                                    Padding="0"
                                    Margin="0,12,0,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20"/>
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#20000000" Offset="0,2" Radius="8" Opacity="0.12"/>
                                </Border.Shadow>
                                <Grid ColumnDefinitions="0.4*,0.6*" ColumnSpacing="0" HeightRequest="160">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer CommandParameter="{Binding .}"
                                              Tapped="OnRoomTapped"/>
                                    </Grid.GestureRecognizers>

                                    <!-- LEFT GRID: Image Section (40%) with Fade Effect -->
                                    <Grid Grid.Column="0" Padding="0">
                                        <!-- Image -->
                                        <Border BackgroundColor="{StaticResource Primary50}" StrokeThickness="0" Padding="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="0,0,0,0"/>
                                            </Border.StrokeShape>
                                            <Image Source="{Binding ImgUrl}" Aspect="AspectFill"/>
                                        </Border>

                                        <!-- White Fade Effect (Right to Left) -->
                                        <BoxView HorizontalOptions="End" VerticalOptions="Fill" WidthRequest="50">
                                            <BoxView.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                                    <GradientStop Color="#FFFFFFFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </BoxView.Background>
                                        </BoxView>

                                        <!-- Status Badge - Stuck to left edge -->
                                        <Border BackgroundColor="{StaticResource Neutral950}" 
                                                StrokeThickness="0"
                                                Padding="10,6"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Start"
                                                Margin="0,8,0,0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="0,16,0,16"/>
                                            </Border.StrokeShape>
                                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6" Padding="2,0">
                                                <Label Grid.Column="0"
                                                       Text="{Binding Status, Converter={StaticResource StatusToStringConverter}}"
                                                       TextColor="{StaticResource NeutralWhite}" 
                                                       FontSize="12" 
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center"/>
                                                <Ellipse Grid.Column="1"
                                                         WidthRequest="8" 
                                                         HeightRequest="8"
                                                         VerticalOptions="Center"
                                                         Fill="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- RIGHT GRID: Content Section (60%) -->
                                    <VerticalStackLayout Grid.Column="1" 
                                                         Padding="16,16,16,16" 
                                                         Spacing="4"
                                                         VerticalOptions="Center"
                                                         HorizontalOptions="End">
                                        <!-- Room Name -->
                                        <Label Text="{Binding Name}"
                                               FontSize="16" 
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Neutral950}" 
                                               LineBreakMode="TailTruncation"
                                               HorizontalOptions="End"
                                               HorizontalTextAlignment="End"/>
                                        <!-- Room Type -->
                                        <Label Text="{Binding RoomType, Converter={StaticResource RoomTypeToStringConverter}}"
                                               FontSize="12" 
                                               TextColor="{StaticResource Neutral600}"
                                               HorizontalOptions="End"
                                               HorizontalTextAlignment="End"/>
                                        <!-- Room Base Price -->
                                        <Label Text="{Binding BasePrice, StringFormat='${0:F2}'}"
                                               FontSize="12" 
                                               TextColor="{StaticResource Neutral600}"
                                               HorizontalOptions="End"
                                               HorizontalTextAlignment="End"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <StackLayout HorizontalOptions="Center" Padding="20">
                            <Label Text="🏨" FontSize="48" HorizontalOptions="Center"/>
                            <Label Text="No current available rooms" FontSize="14"
                                   TextColor="#757575" HorizontalOptions="Center"/>
                        </StackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

                <!-- Occupied Rooms Section -->
                <StackLayout x:Name="OccupiedRoomsSection" IsVisible="False" Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" Margin="4,16,4,8">
                        <Label Text="Currently Occupied Rooms" FontSize="14" FontAttributes="Bold"
                               TextColor="{StaticResource Neutral950}" VerticalOptions="Center"/>
                        <Label x:Name="OccupiedDateLabel" Grid.Column="1" Text=""
                               FontSize="12" TextColor="{StaticResource Neutral600}" 
                               VerticalOptions="Center" HorizontalTextAlignment="End"/>
                    </Grid>

                    <CollectionView x:Name="OccupiedRoomsCollection" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="views:RoomViewModel">
                                <Border BackgroundColor="White" 
                                        StrokeThickness="2" 
                                        Stroke="{StaticResource Primary100}" 
                                        Padding="0"
                                        Margin="0,12,0,0"
                                        Opacity="0.6">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20"/>
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="#20000000" Offset="0,2" Radius="8" Opacity="0.12"/>
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="0.4*,0.6*" ColumnSpacing="0" HeightRequest="160">
                                        <!-- LEFT GRID: Image Section (40%) -->
                                        <Grid Grid.Column="0" Padding="0">
                                            <Border BackgroundColor="{StaticResource Primary50}" StrokeThickness="0" Padding="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="0,0,0,0"/>
                                                </Border.StrokeShape>
                                                <Image Source="{Binding ImgUrl}" Aspect="AspectFill"/>
                                            </Border>

                                            <BoxView HorizontalOptions="End" VerticalOptions="Fill" WidthRequest="50">
                                                <BoxView.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#00FFFFFF" Offset="0" />
                                                        <GradientStop Color="#FFFFFFFF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </BoxView.Background>
                                            </BoxView>

                                            <Border BackgroundColor="{StaticResource Neutral950}" 
                                                    StrokeThickness="0"
                                                    Padding="10,6"
                                                    HorizontalOptions="Start"
                                                    VerticalOptions="Start"
                                                    Margin="0,8,0,0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="0,16,0,16"/>
                                                </Border.StrokeShape>
                                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6" Padding="2,0">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding Status, Converter={StaticResource StatusToStringConverter}}"
                                                           TextColor="{StaticResource NeutralWhite}" 
                                                           FontSize="12" 
                                                           FontAttributes="Bold"
                                                           VerticalOptions="Center"/>
                                                    <Ellipse Grid.Column="1"
                                                             WidthRequest="8" 
                                                             HeightRequest="8"
                                                             VerticalOptions="Center"
                                                             Fill="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <!-- RIGHT GRID: Content Section (60%) -->
                                        <VerticalStackLayout Grid.Column="1" 
                                                             Padding="16,16,16,16" 
                                                             Spacing="4"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding Name}"
                                                   FontSize="16" 
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Neutral950}" 
                                                   LineBreakMode="TailTruncation"
                                                   HorizontalOptions="End"
                                                   HorizontalTextAlignment="End"/>
                                            <Label Text="{Binding RoomType, Converter={StaticResource RoomTypeToStringConverter}}"
                                                   FontSize="12" 
                                                   TextColor="{StaticResource Neutral600}"
                                                   HorizontalOptions="End"
                                                   HorizontalTextAlignment="End"/>
                                            <Label Text="{Binding BasePrice, StringFormat='${0:F2}'}"
                                                   FontSize="12" 
                                                   TextColor="{StaticResource Neutral600}"
                                                   HorizontalOptions="End"
                                                   HorizontalTextAlignment="End"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.EmptyView>
                            <StackLayout HorizontalOptions="Center" Padding="20">
                                <Label Text="🏨" FontSize="48" HorizontalOptions="Center"/>
                                <Label Text="No occupied rooms" FontSize="14"
                                       TextColor="#757575" HorizontalOptions="Center"/>
                            </StackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </StackLayout>

                <!-- Unavailable Rooms Section -->
                <StackLayout x:Name="UnavailableRoomsSection" IsVisible="True" Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" Margin="4,16,4,8">
                        <Label Text="Unavailable Rooms" FontSize="14" FontAttributes="Bold"
                               TextColor="{StaticResource Neutral950}" VerticalOptions="Center"/>
                        <Label x:Name="UnavailableDateLabel" Grid.Column="1" Text=""
                               FontSize="12" TextColor="{StaticResource Neutral600}" 
                               VerticalOptions="Center" HorizontalTextAlignment="End"/>
                    </Grid>

                    <CollectionView x:Name="UnavailableRoomsCollection" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="views:RoomViewModel">
                                <Border BackgroundColor="White" 
                                        StrokeThickness="2" 
                                        Stroke="{StaticResource Primary100}" 
                                        Padding="0"
                                        Margin="0,12,0,0"
                                        Opacity="0.6">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20"/>
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="#20000000" Offset="0,2" Radius="8" Opacity="0.12"/>
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="0.4*,0.6*" ColumnSpacing="0" HeightRequest="160">
                                        <!-- NO TAP GESTURE - Display only -->
                                        <!-- LEFT GRID: Image Section (40%) -->
                                        <Grid Grid.Column="0" Padding="0">
                                            <Border BackgroundColor="{StaticResource Primary50}" StrokeThickness="0" Padding="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="0,0,0,0"/>
                                                </Border.StrokeShape>
                                                <Image Source="{Binding ImgUrl}" Aspect="AspectFill"/>
                                            </Border>

                                            <BoxView HorizontalOptions="End" VerticalOptions="Fill" WidthRequest="50">
                                                <BoxView.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#00FFFFFF" Offset="0" />
                                                        <GradientStop Color="#FFFFFFFF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </BoxView.Background>
                                            </BoxView>

                                            <Border BackgroundColor="{StaticResource Neutral950}" 
                                                    StrokeThickness="0"
                                                    Padding="10,6"
                                                    HorizontalOptions="Start"
                                                    VerticalOptions="Start"
                                                    Margin="0,8,0,0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="0,16,0,16"/>
                                                </Border.StrokeShape>
                                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6" Padding="2,0">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding Status, Converter={StaticResource StatusToStringConverter}}"
                                                           TextColor="{StaticResource NeutralWhite}" 
                                                           FontSize="12" 
                                                           FontAttributes="Bold"
                                                           VerticalOptions="Center"/>
                                                    <Ellipse Grid.Column="1"
                                                             WidthRequest="8" 
                                                             HeightRequest="8"
                                                             VerticalOptions="Center"
                                                             Fill="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <!-- RIGHT GRID: Content Section (60%) -->
                                        <VerticalStackLayout Grid.Column="1" 
                                                             Padding="16,16,16,16" 
                                                             Spacing="4"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding Name}"
                                                   FontSize="16" 
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Neutral950}" 
                                                   LineBreakMode="TailTruncation"
                                                   HorizontalOptions="End"
                                                   HorizontalTextAlignment="End"/>
                                            <Label Text="{Binding RoomType, Converter={StaticResource RoomTypeToStringConverter}}"
                                                   FontSize="12" 
                                                   TextColor="{StaticResource Neutral600}"
                                                   HorizontalOptions="End"
                                                   HorizontalTextAlignment="End"/>
                                            <Label Text="{Binding BasePrice, StringFormat='${0:F2}'}"
                                                   FontSize="12" 
                                                   TextColor="{StaticResource Neutral600}"
                                                   HorizontalOptions="End"
                                                   HorizontalTextAlignment="End"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.EmptyView>
                            <StackLayout HorizontalOptions="Center" Padding="20">
                                <Label Text="🏨" FontSize="48" HorizontalOptions="Center"/>
                                <Label Text="No pre-booked rooms" FontSize="14"
                                       TextColor="#757575" HorizontalOptions="Center"/>
                            </StackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </StackLayout>

            </StackLayout>
        </ScrollView>
    </Grid>
</ContentView>