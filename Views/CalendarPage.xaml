<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:CatHotel.Views"
             xmlns:conv="clr-namespace:CatHotel.Converters"
             x:Class="CatHotel.Views.CalendarPage"
             BackgroundColor="#FFF5F5">

    <ContentView.Resources>
        <conv:RoomStatusToColorConverter x:Key="StatusToColorConverter" />
        <conv:RoomStatusToStringConverter x:Key="StatusToStringConverter" />
        <conv:RoomTypeToStringConverter x:Key="RoomTypeToStringConverter" />
    </ContentView.Resources>

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" BackgroundColor="White" Padding="16,12" MinimumHeightRequest="64" MaximumHeightRequest="64"
                StrokeThickness="0" Margin="0">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.1"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Welcome!" FontSize="22" FontAttributes="Bold"
                       TextColor="#212121" VerticalOptions="Center"/>
                <Image Grid.Column="2" Source="app_icon.svg" HeightRequest="32" WidthRequest="32"/>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" Padding="12,8,8,128">
            <StackLayout Spacing="10">

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4">
                    <Border BackgroundColor="#E91E63" StrokeThickness="0" Padding="10,6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Label x:Name="MonthFilterLabel" Text="Month: -"
                               TextColor="White" FontSize="13" HorizontalOptions="Center"/>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="White" StrokeThickness="1"
                            Stroke="#E0E0E0" Padding="10,6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Label Text="Room Type: SMALL"
                               TextColor="#E91E63" FontSize="13" HorizontalOptions="Center"/>
                    </Border>
                </Grid>

                <Border BackgroundColor="White" StrokeThickness="0" Padding="12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.08"/>
                    </Border.Shadow>
                    <StackLayout Spacing="6">

                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button Text="‹" FontSize="22" BackgroundColor="Transparent"
                                    TextColor="#E91E63" Padding="0" WidthRequest="40"
                                    Clicked="OnPrevMonth"/>
                            <Label x:Name="MonthYearLabel" Grid.Column="1"
                                   Text="-" FontSize="17" FontAttributes="Bold"
                                   TextColor="#212121"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Button Grid.Column="2" Text="›" FontSize="22"
                                    BackgroundColor="Transparent" TextColor="#E91E63"
                                    Padding="0" WidthRequest="40"
                                    Clicked="OnNextMonth"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                            <Label Text="Mon" FontSize="11" TextColor="#9E9E9E" HorizontalOptions="Center"/>
                            <Label Grid.Column="1" Text="Tue" FontSize="11" TextColor="#9E9E9E" HorizontalOptions="Center"/>
                            <Label Grid.Column="2" Text="Wed" FontSize="11" TextColor="#9E9E9E" HorizontalOptions="Center"/>
                            <Label Grid.Column="3" Text="Thu" FontSize="11" TextColor="#9E9E9E" HorizontalOptions="Center"/>
                            <Label Grid.Column="4" Text="Fri" FontSize="11" TextColor="#9E9E9E" HorizontalOptions="Center"/>
                            <Label Grid.Column="5" Text="Sat" FontSize="11" TextColor="#E91E63" HorizontalOptions="Center"/>
                            <Label Grid.Column="6" Text="Sun" FontSize="11" TextColor="#E91E63" HorizontalOptions="Center"/>
                        </Grid>

                        <Grid x:Name="CalendarDaysGrid"/>

                        <StackLayout Orientation="Horizontal" Spacing="16"
                                     HorizontalOptions="Center" Margin="0,4,0,0">
                            <StackLayout Orientation="Horizontal" Spacing="4">
                                <BoxView Color="#FFC107" CornerRadius="5"
                                         WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                                <Label Text="มีการจอง" FontSize="11" TextColor="#757575" VerticalOptions="Center"/>
                            </StackLayout>
                            <StackLayout Orientation="Horizontal" Spacing="4">
                                <BoxView Color="#E91E63" CornerRadius="5"
                                         WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                                <Label Text="วันที่เลือก" FontSize="11" TextColor="#757575" VerticalOptions="Center"/>
                            </StackLayout>
                            <StackLayout Orientation="Horizontal" Spacing="4">
                                <BoxView Color="#FCE4EC" CornerRadius="5"
                                         WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                                <Label Text="วันนี้" FontSize="11" TextColor="#757575" VerticalOptions="Center"/>
                            </StackLayout>
                        </StackLayout>

                    </StackLayout>
                </Border>

                <Label x:Name="SelectedDateLabel" Text="เลือกวันเพื่อดูห้องว่าง"
                       FontSize="14" FontAttributes="Bold"
                       TextColor="#E91E63" Margin="4,0"/>

                <CollectionView x:Name="AvailableRoomsCollection" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="views:RoomViewModel">
                            <Border BackgroundColor="White" 
                    StrokeThickness="2" 
                    Stroke="#F9D0D0" 
                    Padding="0"
                    Margin="0,12,0,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20"/>
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#20000000" Offset="0,2" Radius="8" Opacity="0.12"/>
                                </Border.Shadow>
                                <Grid ColumnDefinitions="0.4*,0.6*" ColumnSpacing="0" HeightRequest="160">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer CommandParameter="{Binding .}"
                                              Tapped="OnRoomTapped"/>
                                    </Grid.GestureRecognizers>

                                    <!-- LEFT GRID: Image Section (40%) with Fade Effect -->
                                    <Grid Grid.Column="0" Padding="0">
                                        <!-- Image -->
                                        <Border BackgroundColor="{StaticResource Primary50}" StrokeThickness="0" Padding="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="18,0,0,18"/>
                                            </Border.StrokeShape>
                                            <Image Source="{Binding ImgUrl}" Aspect="AspectFill"/>
                                        </Border>

                                        <!-- White Fade Effect (Right to Left) -->
                                        <BoxView HorizontalOptions="End" VerticalOptions="Fill" WidthRequest="50">
                                            <BoxView.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                                    <GradientStop Color="#FFFFFFFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </BoxView.Background>
                                        </BoxView>

                                        <!-- Status Badge - Stuck to left edge -->
                                        <Border BackgroundColor="{StaticResource Neutral950}" 
                                                StrokeThickness="0"
                                                Padding="10,6"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Start"
                                                Margin="0,8,0,0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="0,16,0,16"/>
                                            </Border.StrokeShape>
                                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6" Padding="2,0">
                                                <Label Grid.Column="0"
                                                       Text="{Binding Status, Converter={StaticResource StatusToStringConverter}}"
                                                       TextColor="{StaticResource NeutralWhite}" 
                                                       FontSize="12" 
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center"/>
                                                <Ellipse Grid.Column="1"
                                                         WidthRequest="8" 
                                                         HeightRequest="8"
                                                         VerticalOptions="Center"
                                                         Fill="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- RIGHT GRID: Content Section (60%) -->
                                    <VerticalStackLayout Grid.Column="1" 
                                                         Padding="16,16,16,16" 
                                                         Spacing="4"
                                                         VerticalOptions="Center">
                                        <!-- Room Name -->
                                        <Label Text="{Binding Name}"
                                               FontSize="16" 
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Neutral950}" 
                                               LineBreakMode="TailTruncation"
                                               HorizontalOptions="End"
                                               HorizontalTextAlignment="End"/>
                                        <!-- Room Type -->
                                        <Label Text="{Binding RoomType, Converter={StaticResource RoomTypeToStringConverter}}"
                                               FontSize="12" 
                                               TextColor="{StaticResource Neutral600}"
                                               HorizontalOptions="End"
                                               HorizontalTextAlignment="End"/>
                                        <!-- Room Base Price -->
                                        <Label Text="{Binding BasePrice, StringFormat='${0:F2}'}"
                                               FontSize="12" 
                                               TextColor="{StaticResource Neutral600}"
                                               HorizontalOptions="End"
                                               HorizontalTextAlignment="End"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <StackLayout HorizontalOptions="Center" Padding="20">
                            <Label Text="🏨" FontSize="48" HorizontalOptions="Center"/>
                            <Label Text="No rooms found" FontSize="14"
                                   TextColor="#757575" HorizontalOptions="Center"/>
                        </StackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

            </StackLayout>
        </ScrollView>
    </Grid>
</ContentView>