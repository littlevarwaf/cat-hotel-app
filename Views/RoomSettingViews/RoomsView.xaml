<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:CatHotel.Converters"
             x:Class="CatHotel.Views.RoomSettingViews.RoomsView">
    <ContentView.Resources>
        <conv:RoomStatusToColorConverter x:Key="StatusToColorConverter" />
        <conv:RoomStatusToStringConverter x:Key="StatusToStringConverter" />
        <conv:RoomTypeToStringConverter x:Key="RoomTypeToStringConverter" />
    </ContentView.Resources>

    <ContentView.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F7D7D7" Offset="0.0" />
            <GradientStop Color="#FBEAEA" Offset="0.25" />
            <GradientStop Color="#FFF7EF" Offset="1.0" />
        </LinearGradientBrush>
    </ContentView.Background>

    <Grid RowDefinitions="*,Auto">

        <!-- ROOMS LIST - HORIZONTAL CARDS -->
        <CollectionView Grid.Row="0"
                    x:Name="RoomsCollectionView"
                    Margin="16,12,16,0"
                    SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="{StaticResource NeutralWhite}" 
                            StrokeThickness="2" 
                            Stroke="{StaticResource Primary100}" 
                            Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#20000000" Offset="0,2" Radius="8" Opacity="0.12"/>
                        </Border.Shadow>
                        <Grid ColumnDefinitions="0.4*,0.6*" ColumnSpacing="0" HeightRequest="160">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer CommandParameter="{Binding .}"
                                                  Tapped="OnRoomTapped"/>
                            </Grid.GestureRecognizers>

                            <!-- LEFT GRID: Image Section (40%) with Fade Effect -->
                            <Grid Grid.Column="0" Padding="0">
                                <!-- Image -->
                                <Border BackgroundColor="{StaticResource Primary50}" StrokeThickness="0" Padding="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="0,0,0,0"/>
                                    </Border.StrokeShape>
                                    <Image Source="{Binding ImgUrl}" Aspect="AspectFill"/>
                                </Border>

                                <!-- White Fade Effect (Right to Left) -->
                                <BoxView HorizontalOptions="End" VerticalOptions="Fill" WidthRequest="50">
                                    <BoxView.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FFFFFF" Offset="0" />
                                            <GradientStop Color="#FFFFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </BoxView.Background>
                                </BoxView>

                                <!-- Status Badge - Stuck to left edge -->
                                <Border BackgroundColor="{StaticResource Neutral950}" 
                                        StrokeThickness="0"
                                        Padding="10,6"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start"
                                        Margin="0,8,0,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="0,16,0,16"/>
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6" Padding="2,0">
                                        <Label Grid.Column="0"
                                               Text="{Binding Status, Converter={StaticResource StatusToStringConverter}}"
                                               TextColor="{StaticResource NeutralWhite}" 
                                               FontSize="12" 
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"/>
                                        <Ellipse Grid.Column="1"
                                                 WidthRequest="8" 
                                                 HeightRequest="8"
                                                 VerticalOptions="Center"
                                                 Fill="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- RIGHT GRID: Content Section (60%) -->
                            <VerticalStackLayout Grid.Column="1" 
                                                 Padding="16,16,16,16" 
                                                 Spacing="4"
                                                 VerticalOptions="Center">
                                <!-- Room Name -->
                                <Label Text="{Binding Name}"
                                       FontSize="16" 
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Neutral950}" 
                                       LineBreakMode="TailTruncation"
                                       HorizontalOptions="End"
                                       HorizontalTextAlignment="End"/>
                                <!-- Room Type -->
                                <Label Text="{Binding RoomType, Converter={StaticResource RoomTypeToStringConverter}}"
                                       FontSize="12" 
                                       TextColor="{StaticResource Neutral600}"
                                       HorizontalOptions="End"
                                       HorizontalTextAlignment="End"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Footer spacing -->
            <CollectionView.Footer>
                <BoxView HeightRequest="80" BackgroundColor="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- Gradient overlay behind search bar -->
        <BoxView Grid.Row="0" ZIndex="0" VerticalOptions="End" HeightRequest="96">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFF7EF" Offset="1" />
                    <GradientStop Color="#00FFF7EF" Offset="0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Floating Search Bar -->
        <Border Grid.Row="0" 
                ZIndex="1"
                Style="{StaticResource RoundedInputContainerStyle}"
                Margin="16,0,16,16" 
                Padding="12,0,12,0"
                VerticalOptions="End"
                HeightRequest="56">
            <Grid ColumnDefinitions="Auto,*">
                <Image Grid.Column="0" Source="search_icon.svg" HeightRequest="16" WidthRequest="16" VerticalOptions="Center"/>
                <Border Grid.Column="1" BackgroundColor="Transparent" Stroke="Transparent">
                    <Entry x:Name="SearchEntry" Style="{StaticResource RoundedEntryStyle}"
                           Placeholder="Search rooms..." TextChanged="OnSearchTextChanged" />
                </Border>
            </Grid>
        </Border>

    </Grid>
</ContentView>