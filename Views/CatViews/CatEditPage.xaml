<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatHotel.Views.CatViews.CatEditPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <StaticResource Key="PageBackgroundBrush" />
    </ContentPage.Background>

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Border Grid.Row="0" BackgroundColor="Transparent" Padding="16,0,32,0" MinimumHeightRequest="56"
            StrokeThickness="0" Margin="0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="0">
                <!-- Back Button -->
                <Button Grid.Column="0"
                    ImageSource="chevron_left.svg"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Neutral950}"
                    FontSize="28"
                    Padding="8,0"
                    Clicked="OnBackClicked"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"/>

                <!-- Title -->
                <Label Grid.Column="1"
                   Text="Edit Cat Details"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="#1A1A1A"
                   HorizontalOptions="Center"
                   VerticalTextAlignment="Center"
                   HorizontalTextAlignment="Center"/>

                <!-- Paw Icon -->
                <Image Grid.Column="2"
                   Source="app_icon.svg"
                   HeightRequest="28"
                   WidthRequest="28"
                   HorizontalOptions="End"
                   VerticalOptions="Center"/>
            </Grid>
        </Border>

        <!-- FORM SCROLL -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,16,16,120" Spacing="0">

                <Label Text="Cat Details"
                       FontSize="16" FontAttributes="Bold"
                       TextColor="#1A1A1A" Margin="0,0,0,12"/>

                <!-- Image Card -->
                <Border BackgroundColor="{StaticResource NeutralWhite}" Stroke="{StaticResource Primary100}" StrokeThickness="1"
                        Padding="16" Margin="0,0,0,16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#20000000" Offset="0,3" Radius="8" Opacity="0.15"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Border HeightRequest="180" WidthRequest="240"
                                StrokeThickness="0" HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6"/>
                            </Border.StrokeShape>
                            <Image x:Name="CatPhotoPreview"
                                   Source="placeholder_item.png"
                                   Aspect="AspectFill"
                                   HeightRequest="180" WidthRequest="180"/>
                        </Border>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Border Grid.Column="0" StrokeThickness="1" Stroke="{StaticResource Primary100}"
                                    BackgroundColor="{StaticResource NeutralWhite}" Padding="0,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="999"/>
                                </Border.StrokeShape>
                                <Label Text="Remove Image" FontSize="13"
                                       TextColor="{StaticResource Primary900}" HorizontalOptions="Center"/>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRemoveImageTapped"/>
                                </Border.GestureRecognizers>
                            </Border>
                            <Border Grid.Column="1" StrokeThickness="0"
                                    BackgroundColor="{StaticResource Primary}" Padding="0,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="999"/>
                                </Border.StrokeShape>
                                <Label Text="Upload Image" FontSize="13"
                                       TextColor="{StaticResource Primary900}" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnUploadImageTapped"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Input Fields Card -->
                <Border BackgroundColor="{StaticResource NeutralWhite}" Stroke="{StaticResource Primary100}" StrokeThickness="1"
                        Padding="16" Margin="0,0,0,24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#20000000" Offset="0,3" Radius="8" Opacity="0.15"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="24">

                        <!-- Cat Name -->
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                <Image Grid.Column="0" Source="cupcake_icon.svg" HeightRequest="16" WidthRequest="16"/>
                                <Label Grid.Column="1" Text="Cat Name"
                                       FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Neutral950}"/>
                            </Grid>
                            <Border Style="{StaticResource RoundedInputContainerStyle}">
                                <Entry x:Name="NameEntry" 
                                       Placeholder="e.g., Whiskers, Mittens"
                                       Style="{StaticResource RoundedEntryStyle}"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Breed -->
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                <Image Grid.Column="0" Source="note_icon.svg" HeightRequest="16" WidthRequest="16"/>
                                <Label Grid.Column="1" Text="Breed"
                                       FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Neutral950}"/>
                            </Grid>
                            <Border Style="{StaticResource RoundedInputContainerStyle}">
                                <Entry x:Name="BreedEntry"
                                       Placeholder="e.g., Persian, Siamese"
                                       Style="{StaticResource RoundedEntryStyle}"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Age -->
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                <Image Grid.Column="0" Source="dollar_icon.svg" HeightRequest="16" WidthRequest="16"/>
                                <Label Grid.Column="1" Text="Age (Years)"
                                       FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Neutral950}"/>
                            </Grid>
                            <Border Style="{StaticResource RoundedInputContainerStyle}">
                                <Entry x:Name="AgeEntry"
                                       Placeholder="e.g., 3"
                                       Keyboard="Numeric"
                                       Style="{StaticResource RoundedEntryStyle}"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Gender -->
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                <Image Grid.Column="0" Source="help_icon.svg" HeightRequest="16" WidthRequest="16"/>
                                <Label Grid.Column="1" Text="Gender"
                                       FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Neutral950}"/>
                            </Grid>
                            <HorizontalStackLayout Spacing="20">
                                <HorizontalStackLayout Spacing="8">
                                    <RadioButton x:Name="UnknownGenderRadio"
                                             Value="Unknown" GroupName="Gender"
                                             CheckedChanged="OnGenderChanged"/>
                                    <Label Text="Unknown" FontSize="13" TextColor="#1A1A1A"
                                       VerticalTextAlignment="Center"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8">
                                    <RadioButton x:Name="MaleGenderRadio"
                                             Value="Male" GroupName="Gender"
                                             CheckedChanged="OnGenderChanged"/>
                                    <Label Text="Male" FontSize="13" TextColor="#1A1A1A"
                                       VerticalTextAlignment="Center"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8">
                                    <RadioButton x:Name="FemaleGenderRadio"
                                             Value="Female" GroupName="Gender"
                                             CheckedChanged="OnGenderChanged"/>
                                    <Label Text="Female" FontSize="13" TextColor="#1A1A1A"
                                       VerticalTextAlignment="Center"/>
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Delete Row -->
                <Border BackgroundColor="{StaticResource NeutralWhite}" Stroke="{StaticResource Primary100}" StrokeThickness="1"
                        Padding="16" Margin="0,0,0,16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#20000000" Offset="0,3" Radius="8" Opacity="0.15"/>
                    </Border.Shadow>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Delete Current Cat?"
                               FontSize="14" TextColor="{StaticResource Neutral950}"
                               VerticalTextAlignment="Center"/>
                        <Border Grid.Column="1" BackgroundColor="{StaticResource Primary}" StrokeThickness="0">
                            <Border.StrokeShape>
                                <Ellipse />
                            </Border.StrokeShape>

                            <Button
                                WidthRequest="32"
                                HeightRequest="32"
                                CornerRadius="35"
                                BackgroundColor="{StaticResource Primary}"
                                ImageSource="trash_icon.svg"
                                Clicked="OnDeleteCatClicked">
                            </Button>
                        </Border>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Gradient overlay behind buttons -->
        <BoxView Grid.Row="1" ZIndex="0" VerticalOptions="End" HeightRequest="128">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFF7EF" Offset="1" />
                    <GradientStop Color="#00FFF7EF" Offset="0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Button Stack at Bottom -->
        <StackLayout Grid.Row="1" ZIndex="1" Margin="30,0,30,40" VerticalOptions="End" Spacing="12">
            <!-- Save Button -->
            <Border BackgroundColor="{StaticResource Primary500}" StrokeThickness="0" Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28"/>
                </Border.StrokeShape>
                <Label Text="Save Changes" TextColor="White" FontSize="16"
                   FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"
                   Padding="0,16"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSaveTapped"/>
                </Border.GestureRecognizers>
            </Border>
        </StackLayout>

    </Grid>
</ContentPage>