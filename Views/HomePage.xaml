<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:CatHotel.Views"
             xmlns:conv="clr-namespace:CatHotel.Converters"
             x:Class="CatHotel.Views.HomePage">

    <ContentView.Resources>
        <conv:RoomStatusToColorConverter x:Key="StatusToColorConverter" />
        <conv:RoomStatusToStringConverter x:Key="StatusToStringConverter" />
        <conv:RoomTypeToStringConverter x:Key="RoomTypeToStringConverter" />
    </ContentView.Resources>

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" BackgroundColor="White" Padding="16,12" MinimumHeightRequest="64" MaximumHeightRequest="64"
                StrokeThickness="0" Margin="0">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.1"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <Label Text="Active Bookings" FontSize="22" FontAttributes="Bold"
                       TextColor="#212121" VerticalOptions="Center"/>
                <Button x:Name="EditButton" Grid.Column="1"
                        ImageSource="edit_pencil_icon.svg" BackgroundColor="Transparent"
                        FontSize="20" Padding="4,0"
                        Clicked="OnEditClicked"
                        IsVisible="False"/>
                <Image Grid.Column="2" Source="app_icon.svg" BackgroundColor="Transparent" HeightRequest="32" WidthRequest="32"/>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" Padding="16,12,16,128">
            <VerticalStackLayout Spacing="8">

                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <Border BackgroundColor="{StaticResource Primary500}" StrokeThickness="0"
                            Padding="12,6" HorizontalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Label x:Name="OccupiedLabel" Text="Occupied Rooms: 0"
                               TextColor="White" FontSize="13" FontAttributes="Bold"/>
                    </Border>
                    <Label Grid.Column="1" x:Name="DateLabel" Text=""
                           TextColor="#757575" FontSize="13" VerticalOptions="Center"/>
                </Grid>

                <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False"
                                   IsVisible="False" Color="{StaticResource Primary500}"
                                   HorizontalOptions="Center"/>

                <CollectionView x:Name="RoomsCollection" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="views:RoomViewModel">
                            <Border BackgroundColor="White" 
                                    StrokeThickness="2" 
                                    Stroke="#F9D0D0" 
                                    Padding="0"
                                    Margin="0,12,0,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20"/>
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#20000000" Offset="0,2" Radius="8" Opacity="0.12"/>
                                </Border.Shadow>
                                <Grid ColumnDefinitions="0.4*,0.6*" ColumnSpacing="0" HeightRequest="160">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer CommandParameter="{Binding .}"
                                                              Tapped="OnRoomTapped"/>
                                    </Grid.GestureRecognizers>

                                    <!-- LEFT GRID: Image Section (40%) with Fade Effect -->
                                    <Grid Grid.Column="0" Padding="0">
                                        <!-- Image -->
                                        <Border BackgroundColor="{StaticResource Primary50}" StrokeThickness="0" Padding="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="0,0,0,0"/>
                                            </Border.StrokeShape>
                                            <Image Source="{Binding ImgUrl}" Aspect="AspectFill"/>
                                        </Border>

                                        <!-- White Fade Effect (Right to Left) -->
                                        <BoxView HorizontalOptions="End" VerticalOptions="Fill" WidthRequest="50">
                                            <BoxView.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                                    <GradientStop Color="#FFFFFFFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </BoxView.Background>
                                        </BoxView>

                                        <!-- Status Badge - Stuck to left edge -->
                                        <Border BackgroundColor="{StaticResource Neutral950}" 
                                            StrokeThickness="0"
                                            Padding="10,6"
                                            HorizontalOptions="Start"
                                            VerticalOptions="Start"
                                            Margin="0,8,0,0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="0,16,0,16"/>
                                            </Border.StrokeShape>
                                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6" Padding="2,0">
                                                <Label Grid.Column="0"
                                                   Text="{Binding Status, Converter={StaticResource StatusToStringConverter}}"
                                                   TextColor="{StaticResource NeutralWhite}" 
                                                   FontSize="12" 
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center"/>
                                                <Ellipse Grid.Column="1"
                                                     WidthRequest="8" 
                                                     HeightRequest="8"
                                                     VerticalOptions="Center"
                                                     Fill="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- RIGHT GRID: Content Section (60%) -->
                                    <VerticalStackLayout Grid.Column="1" 
                                                     Padding="16,16,16,16" 
                                                     Spacing="4"
                                                     VerticalOptions="Center">
                                        <!-- Room Name -->
                                        <Label Text="{Binding Name}"
                                           FontSize="16" 
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Neutral950}" 
                                           LineBreakMode="TailTruncation"
                                           HorizontalOptions="End"
                                           HorizontalTextAlignment="End"/>
                                        <!-- Room Type -->
                                        <Label Text="{Binding RoomType, Converter={StaticResource RoomTypeToStringConverter}}"
                                           FontSize="12" 
                                           TextColor="{StaticResource Neutral600}"
                                           HorizontalOptions="End"
                                           HorizontalTextAlignment="End"/>
                                        <!-- Room Base Price -->
                                        <Label Text="{Binding BasePrice, StringFormat='${0:F2}'}"
                                           FontSize="12" 
                                           TextColor="{StaticResource Neutral600}"
                                           HorizontalOptions="End"
                                           HorizontalTextAlignment="End"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <StackLayout HorizontalOptions="Center" Padding="20">
                            <Label Text="🏨" FontSize="48" HorizontalOptions="Center"/>
                            <Label Text="No occupied rooms" FontSize="14"
                                   TextColor="#757575" HorizontalOptions="Center"/>
                        </StackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>