<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:CatHotel.Views"
             x:Class="CatHotel.Views.HomePage"
             BackgroundColor="#FFF5F5">

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" BackgroundColor="White" Padding="16,12"
                StrokeThickness="0" Margin="0">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.1"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Label Text="Welcome!" FontSize="22" FontAttributes="Bold"
                       TextColor="#212121" VerticalOptions="Center"/>
                <Button x:Name="EditButton" Grid.Column="1"
                        Text="✏️" BackgroundColor="Transparent"
                        FontSize="20" Padding="4,0"
                        Clicked="OnEditClicked"
                        IsVisible="False"/>
                <Image Grid.Column="2" Source="app_icon.svg" HeightRequest="32" WidthRequest="32"/>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" Padding="12,8">
            <StackLayout Spacing="8">

                <Grid ColumnDefinitions="*,Auto" Margin="4,4,4,8">
                    <Border BackgroundColor="#E91E63" StrokeThickness="0"
                            Padding="12,6" HorizontalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Label x:Name="AvailableLabel" Text="Available Rooms: 0"
                               TextColor="White" FontSize="13" FontAttributes="Bold"/>
                    </Border>
                    <Label Grid.Column="1" x:Name="DateLabel" Text=""
                           TextColor="#757575" FontSize="13" VerticalOptions="Center"/>
                </Grid>

                <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False"
                                   IsVisible="False" Color="#E91E63"
                                   HorizontalOptions="Center"/>

                <CollectionView x:Name="RoomsCollection" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="views:RoomViewModel">
                            <Border BackgroundColor="White" StrokeThickness="0" Margin="0,4">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08"/>
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRoomTapped"
                                                          CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="130,*" HeightRequest="90">

                                    <Border BackgroundColor="#FFCCBC" StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12,0,0,12"/>
                                        </Border.StrokeShape>
                                        <Grid>
                                            <Label Text="🏠" FontSize="36"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>

                                            <Border Margin="6,6,0,0" Padding="6,3"
                                                    BackgroundColor="{Binding StatusBadgeColor}"
                                                    StrokeThickness="0"
                                                    HorizontalOptions="Start" VerticalOptions="Start">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10"/>
                                                </Border.StrokeShape>
                                                <Label Text="{Binding StatusBadgeText}"
                                                       TextColor="White" FontSize="10"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <StackLayout Grid.Column="1" VerticalOptions="Center" Padding="12,0">
                                        <Label Text="{Binding Name}" FontSize="15"
                                               FontAttributes="Bold" TextColor="#212121"/>
                                        <Label Text="{Binding RoomTypeDisplay}"
                                               FontSize="12" TextColor="#757575"/>
                                        <Label Text="{Binding BasePriceDisplay}"
                                               FontSize="12" TextColor="#E91E63"/>
                                    </StackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <StackLayout HorizontalOptions="Center" Padding="20">
                            <Label Text="🏨" FontSize="48" HorizontalOptions="Center"/>
                            <Label Text="No rooms found" FontSize="14"
                                   TextColor="#757575" HorizontalOptions="Center"/>
                        </StackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

            </StackLayout>
        </ScrollView>
    </Grid>
</ContentView>
