<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatHotel.Views.DiscountSettingViews.DiscountsView">
    <ContentView.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F7D7D7" Offset="0.0" />
            <GradientStop Color="#FBEAEA" Offset="0.25" />
            <GradientStop Color="#FFF7EF" Offset="1.0" />
        </LinearGradientBrush>
    </ContentView.Background>

    <Grid RowDefinitions="*,Auto">

        <!-- DISCOUNTS LIST -->
        <CollectionView Grid.Row="0"
                    x:Name="DiscountsCollectionView"
                    Margin="16,12,16,0"
                    SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="White" StrokeThickness="0" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#20000000" Offset="0,2" Radius="6" Opacity="0.12"/>
                        </Border.Shadow>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer CommandParameter="{Binding .}"
                                                  Tapped="OnDiscountTapped"/>
                            </Grid.GestureRecognizers>
                            <!-- Left Section: Code and Description -->
                            <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding Description}"
                                   FontSize="11" TextColor="{StaticResource Neutral600}"
                                   LineBreakMode="TailTruncation"/>
                                <Label Text="{Binding Code}"
                                   FontSize="20" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary500}" LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>

                            <!-- Right Section: Expiration Date, Amount, and Quantity -->
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center" HorizontalOptions="End">
                                <Label Text="{Binding ExpirationDate, StringFormat='{0:MMM dd, yyyy}'}"
                                   FontSize="11" TextColor="#9E9090"
                                   HorizontalTextAlignment="End"/>
                                <Label Text="{Binding Amount, StringFormat='฿{0:N0}'}"
                                   FontSize="24" FontAttributes="Bold"
                                   TextColor="#1A1A1A"
                                   HorizontalTextAlignment="End"/>
                                <Label Text="{Binding UsedCount, StringFormat='{0}/{1} left'}"
                                   FontSize="12" TextColor="#9E9090"
                                   HorizontalTextAlignment="End">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding UsedCount}" />
                                            <Span Text="/" />
                                            <Span Text="{Binding Quantity}" />
                                            <Span Text=" left" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Footer spacing -->
            <CollectionView.Footer>
                <BoxView HeightRequest="80" BackgroundColor="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- Gradient overlay behind search bar -->
        <BoxView Grid.Row="0" ZIndex="0" VerticalOptions="End" HeightRequest="96">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFF7EF" Offset="1" />
                    <GradientStop Color="#00FFF7EF" Offset="0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Floating Search Bar -->
        <Border Grid.Row="0" 
                ZIndex="1"
                Style="{StaticResource RoundedInputContainerStyle}"
                Margin="16,0,16,16" 
                Padding="12,0,12,0"
                VerticalOptions="End"
                HeightRequest="56">
            <Grid ColumnDefinitions="Auto,*">
                <Image Grid.Column="0" Source="search_icon.svg" HeightRequest="16" WidthRequest="16" VerticalOptions="Center"/>
                <Border Grid.Column="1" BackgroundColor="Transparent" Stroke="Transparent">
                    <Entry x:Name="SearchEntry" Style="{StaticResource RoundedEntryStyle}"
                           Placeholder="Search discounts..." TextChanged="OnSearchTextChanged" />
                </Border>
            </Grid>
        </Border>

    </Grid>
</ContentView>