<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatHotel.Views.DiscountSettingViews.DiscountEditPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <StaticResource Key="PageBackgroundBrush" />
    </ContentPage.Background>

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Border Grid.Row="0" BackgroundColor="Transparent" Padding="16,0,32,0" MinimumHeightRequest="56"
                StrokeThickness="0" Margin="0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="0">
                <!-- Back Button -->
                <Button Grid.Column="0"
                        ImageSource="chevron_left.svg"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Neutral950}"
                        FontSize="28"
                        Padding="8,0"
                        Clicked="OnBackClicked"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"/>

                <!-- Title -->
                <Label Grid.Column="1"
                       Text="{Binding DiscountCode, StringFormat='{0} - Edit Details'}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#1A1A1A"
                       HorizontalOptions="Center"
                       VerticalTextAlignment="Center"
                       HorizontalTextAlignment="Center"/>

                <!-- Paw Icon -->
                <Image Grid.Column="2"
                       Source="app_icon.svg"
                       HeightRequest="28"
                       WidthRequest="28"
                       HorizontalOptions="End"
                       VerticalOptions="Center"/>
            </Grid>
        </Border>

        <!-- FORM SCROLL -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,16,16,120" Spacing="0">

                <Label Text="Discount Details"
                   FontSize="16" FontAttributes="Bold"
                   TextColor="#1A1A1A" Margin="0,0,0,12"/>

                <!-- Input Fields Card -->
                <Border BackgroundColor="{StaticResource NeutralWhite}" Stroke="{StaticResource Primary100}" StrokeThickness="1"
                    Padding="16" Margin="0,0,0,24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#20000000" Offset="0,3" Radius="8" Opacity="0.15"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="24">

                        <!-- Discount Code (Read-only) -->
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                <Image Grid.Column="0" Source="building_icon.svg" HeightRequest="16" WidthRequest="16"/>
                                <Label Grid.Column="1" Text="Discount Code"
                                       FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Neutral950}"/>
                            </Grid>
                            <Border Style="{StaticResource RoundedInputContainerStyle}" BackgroundColor="#F5F5F5">
                                <Entry x:Name="DiscountCodeEntry" 
                                   Placeholder="e.g., SUMMER20"
                                   Style="{StaticResource RoundedEntryStyle}"
                                   IsReadOnly="True"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Description -->
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                <Image Grid.Column="0" Source="star_icon.svg" HeightRequest="16" WidthRequest="16"/>
                                <Label Grid.Column="1" Text="Description"
                                   FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Neutral950}"/>
                            </Grid>
                            <Border Style="{StaticResource RoundedInputContainerStyle}">
                                <Entry x:Name="DiscountDescriptionEntry" 
                                   Placeholder="e.g., Summer 20% off"
                                   Style="{StaticResource RoundedEntryStyle}"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Discount Amount (Read-only) -->
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                <Image Grid.Column="0" Source="dollar_icon.svg" HeightRequest="16" WidthRequest="16"/>
                                <Label Grid.Column="1" Text="Discount Amount"
                                       FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Neutral950}"/>
                            </Grid>
                            <Border Style="{StaticResource RoundedInputContainerStyle}" BackgroundColor="#F5F5F5">
                                <Entry x:Name="DiscountAmountEntry" 
                                   Placeholder="e.g., 100"
                                   Keyboard="Numeric"
                                   Style="{StaticResource RoundedEntryStyle}"
                                   IsReadOnly="True"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Quantity -->
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                <Image Grid.Column="0" Source="group_icon.svg" HeightRequest="16" WidthRequest="16"/>
                                <Label Grid.Column="1" Text="Total Quantity"
                                       FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Neutral950}"/>
                            </Grid>
                            <Border Style="{StaticResource RoundedInputContainerStyle}">
                                <Entry x:Name="DiscountQuantityEntry" 
                                   Placeholder="e.g., 50"
                                   Keyboard="Numeric"
                                   Style="{StaticResource RoundedEntryStyle}"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Used Count -->
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                <Image Grid.Column="0" Source="group_icon.svg" HeightRequest="16" WidthRequest="16"/>
                                <Label Grid.Column="1" Text="Used Count"
                                       FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Neutral950}"/>
                            </Grid>
                            <Border Style="{StaticResource RoundedInputContainerStyle}">
                                <Entry x:Name="UsedCountEntry" 
                                   Placeholder="e.g., 10"
                                   Keyboard="Numeric"
                                   Style="{StaticResource RoundedEntryStyle}"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Expiration Date -->
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                <Image Grid.Column="0" Source="help_icon.svg" HeightRequest="16" WidthRequest="16"/>
                                <Label Grid.Column="1" Text="Expiration Date"
                                       FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Neutral950}"/>
                            </Grid>
                            <Border Style="{StaticResource RoundedPickerContainerStyle}">
                                <DatePicker x:Name="ExpirationDatePicker"
                                    Style="{StaticResource RoundedPickerStyle}"/>
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Delete Row -->
                <Border BackgroundColor="{StaticResource NeutralWhite}" Stroke="{StaticResource Primary100}" StrokeThickness="1"
                        Padding="16" Margin="0,0,0,16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#20000000" Offset="0,3" Radius="8" Opacity="0.15"/>
                    </Border.Shadow>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Delete Current Discount?"
                               FontSize="14" TextColor="{StaticResource Neutral950}"
                               VerticalTextAlignment="Center"/>
                        <Border Grid.Column="1" BackgroundColor="{StaticResource Primary}" StrokeThickness="0">
                            <Border.StrokeShape>
                                <Ellipse />
                            </Border.StrokeShape>

                            <Button
                                WidthRequest="32"
                                HeightRequest="32"
                                CornerRadius="35"
                                BackgroundColor="{StaticResource Primary}"
                                ImageSource="trash_icon.svg"
                                Clicked="OnDeleteDiscountClicked">
                            </Button>
                        </Border>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Gradient overlay behind save button -->
        <BoxView Grid.Row="1" ZIndex="0" VerticalOptions="End" HeightRequest="128">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFF7EF" Offset="1" />
                    <GradientStop Color="#00FFF7EF" Offset="0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Floating Save Button -->
        <Border Grid.Row="1" ZIndex="1" Margin="30,0,30,40" HeightRequest="64"
                BackgroundColor="Transparent" StrokeThickness="0"
                VerticalOptions="End">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#E06060" Offset="0,4" Radius="12" Opacity="0.4" />
            </Border.Shadow>
            <Border BackgroundColor="{StaticResource Primary500}" StrokeThickness="0" Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="38"/>
                </Border.StrokeShape>
                <Label Text="Save" TextColor="White" FontSize="16"
                       FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSaveTapped"/>
                </Border.GestureRecognizers>
            </Border>
        </Border>

    </Grid>
</ContentPage>