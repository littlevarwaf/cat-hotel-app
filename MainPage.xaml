<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             xmlns:tabs="http://sharpnado.com"
             xmlns:views="clr-namespace:CatHotel.Views"
             Shell.NavBarIsVisible="False"
             x:Class="CatHotel.MainPage">

    <Grid RowDefinitions="*, Auto">

        <tabs:ViewSwitcher Grid.Row="0" 
                           SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <views:TestView />
            <views:TestView2 />
            <views:Sales />
        </tabs:ViewSwitcher>

        <Border Grid.Row="1" Margin="30,10,30,40" HeightRequest="70" BackgroundColor="#F0F0F3" StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="35" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="4,4" Radius="10" Opacity="0.1" />
            </Border.Shadow>

            <tabs:TabHostView
                SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                BackgroundColor="Transparent"
                TabType="Fixed">

                <tabs:BottomTabItem Label="Home" IconImageSource="home_icon.svg" UnselectedIconColor="{StaticResource NeutralBase}" SelectedTabColor="{StaticResource Primary500}" />
                <tabs:BottomTabItem Label="Calendar" IconImageSource="calendar_icon.svg" UnselectedIconColor="{StaticResource NeutralBase}" SelectedTabColor="{StaticResource Primary500}" />
                <tabs:BottomTabItem Label="Sales" IconImageSource="chart_icon.svg" UnselectedIconColor="{StaticResource NeutralBase}" SelectedTabColor="{StaticResource Primary500}" />

            </tabs:TabHostView>
        </Border>
    </Grid>

</ContentPage>
